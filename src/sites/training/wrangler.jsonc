{
	// Worker of the training site. Picked by astro.config.mjs (configPath) when SITE_ID=training;
	// the build writes dist/server/wrangler.json with this name, so `npx wrangler deploy` needs no --config.
	"name": "vomluchberg-training",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	// Worker Previews for non-production branches (Workers Builds, docs/plan/03-betrieb.md §3).
	"previews": {},
	"preview_urls": true,
	// Custom Domains (docs/plan/03-betrieb.md O5/O11): the site's own domain, canonical with www
	// (SITE_URL=https://www.alltag-kann-sport.de), the apex until a 301 rule to www exists, and the
	// old preview host that Karo already has. Cloudflare creates DNS records and certificates on
	// deploy (the Workers Builds token has "Workers Routes: Edit" on all zones). SITE_NOINDEX=true
	// stays on until Karo signs off the site and the legal pages are complete.
	"routes": [
		{ "pattern": "www.alltag-kann-sport.de", "custom_domain": true },
		{ "pattern": "alltag-kann-sport.de", "custom_domain": true },
		{ "pattern": "training.vomluchberg.de", "custom_domain": true }
	]
}
