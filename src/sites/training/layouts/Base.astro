---
import '../styles/global.css';
import BaseHead from '../../../components/BaseHead.astro';
import Lightbox from '../../../components/Lightbox.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeVorschau from '../components/ThemeVorschau.astro';
import AnspracheVorschau from '../components/AnspracheVorschau.astro';
import Faehrte from '../components/Faehrte.astro';
import { faehrteArt } from '../lib/faehrte';
import { getConfig } from '../lib/data';
import { islands } from '../lib/islands';
import { headMeta, type Seo } from '../../../lib/domain/seo';
import { localBusinessJsonLd } from '../../../lib/domain/localBusiness';
import { training } from '../site';
import { farbschema } from '../lib/farbschema';

type Props = Partial<Seo>;

const config = (await getConfig()).data?.trainingConfig ?? null;
const meta = headMeta(Astro.props, config?.website, training.name);
const schema = farbschema(config?.farbschema);
const w = config?.website;
const k = config?.kontakt;
// LocalBusiness on the start page only (docs/plan/02-training.md §3 "Local SEO").
const startseite = Astro.url.pathname === '/';
// The margin paw trail of the sub pages (lib/faehrte.ts decides which).
const faehrte = faehrteArt(Astro.url.pathname);
const betrieb =
	startseite &&
	localBusinessJsonLd({
		name: [w?.name ?? training.name, w?.untertitel].filter(Boolean).join(' – '),
		url: Astro.site?.href ?? Astro.url.origin,
		beschreibung: w?.beschreibung,
		bild: w?.teilenBild,
		logo: w?.logo,
		strasse: k?.strasse,
		ort: k?.ort,
		region: k?.region,
		email: k?.email,
		telefon: k?.telefon,
		sameAs: [config?.social?.instagram, config?.querverweis?.link],
		areaServed: ['Glashütte', 'Dippoldiswalde', 'Altenberg', 'Osterzgebirge', 'Landkreis Sächsische Schweiz-Osterzgebirge'],
	});
---

<!doctype html>
<html lang="de" class="overflow-x-clip" data-site="training" data-scheme={schema.id}>
	<head>
		<BaseHead {...meta} themeColor={schema.themeColor} />
		<ThemeVorschau kopf />
		{betrieb && <script type="application/ld+json" set:html={JSON.stringify(betrieb)} />}
	</head>
	<body class="flex min-h-dvh flex-col overflow-x-clip">
		<a href="#inhalt" class="btn-primary fixed top-4 left-4 z-50 -translate-y-[300%] focus:translate-y-0">Zum Inhalt springen</a>
		<TinaIsland name="global" wrapper={islands.global.wrapper}>
			<Header config={config} />
		</TinaIsland>
		<div id="inhalt" class="relative flex-1">
			<slot />
			{faehrte && <Faehrte art={faehrte} />}
		</div>
		<TinaIsland name="global-footer" wrapper={islands['global-footer'].wrapper}>
			<Footer config={config} />
		</TinaIsland>
		<Lightbox />
		<ThemeVorschau />
		<AnspracheVorschau />
	</body>
</html>
