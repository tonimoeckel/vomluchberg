---
import '../styles/global.css';
import BaseHead from '../../../components/BaseHead.astro';
import Lightbox from '../../../components/Lightbox.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getConfig } from '../lib/data';
import { islands } from '../lib/islands';
import { headMeta, type Seo } from '../../../lib/domain/seo';
import { localBusinessJsonLd } from '../../../lib/domain/localBusiness';
import { training } from '../site';

type Props = Partial<Seo>;

const config = (await getConfig()).data?.trainingConfig ?? null;
const meta = headMeta(Astro.props, config?.website, training.name);
// Keep in sync with --bg (light / dark) in ../styles/global.css.
const themeColor = { light: '#f6f2ea', dark: '#0f1f33' };
const w = config?.website;
const k = config?.kontakt;
// LocalBusiness on the start page only (docs/plan/02-training.md §3 "Local SEO").
const startseite = Astro.url.pathname === '/';
const betrieb =
	startseite &&
	localBusinessJsonLd({
		name: [w?.name ?? training.name, w?.untertitel].filter(Boolean).join(' – '),
		url: Astro.site?.href ?? Astro.url.origin,
		beschreibung: w?.beschreibung,
		bild: w?.teilenBild,
		logo: w?.logo,
		strasse: k?.strasse,
		ort: k?.ort,
		region: k?.region,
		email: k?.email,
		telefon: k?.telefon,
		sameAs: [config?.social?.instagram, config?.querverweis?.link],
		areaServed: ['Glashütte', 'Dippoldiswalde', 'Altenberg', 'Osterzgebirge', 'Landkreis Sächsische Schweiz-Osterzgebirge'],
	});
---

<!doctype html>
<html lang="de" data-site="training">
	<head>
		<BaseHead {...meta} themeColor={themeColor} />
		{betrieb && <script type="application/ld+json" set:html={JSON.stringify(betrieb)} />}
	</head>
	<body class="flex min-h-dvh flex-col">
		<a href="#inhalt" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 btn-primary">Zum Inhalt springen</a>
		<TinaIsland name="global" wrapper={islands.global.wrapper}>
			<Header config={config} />
		</TinaIsland>
		<div id="inhalt" class="flex-1">
			<slot />
		</div>
		<TinaIsland name="global-footer" wrapper={islands['global-footer'].wrapper}>
			<Footer config={config} />
		</TinaIsland>
		<Lightbox />
	</body>
</html>
