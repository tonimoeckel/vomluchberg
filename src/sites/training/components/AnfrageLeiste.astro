---
// The sticky inquiry bar (the page's signature): the hero's "hinweis" and its first button. It sits
// right below the start page's hero, then pins to the top of the screen until the footer. Pure CSS
// (position: sticky inside the block wrapper of Blocks.astro), no JS. Text hidden on phones, where the
// hero shows it instead. Static: the start page's one motion is the hero's paw trail.
import { tinaField } from '@tinacms/astro/tina-field';
import type { BlockOf } from '../lib/data';

interface Props { data: BlockOf<'Hero'> }
const { data } = Astro.props;
const knopf = (data.buttons ?? []).find((b) => b && b.stil !== 'sekundaer') ?? null;
---
{(data.hinweis || knopf) && (
	<aside aria-label="Training anfragen" class="anfrage-leiste sticky top-0 z-[var(--z-sticky)] border-y border-heading bg-bg">
		<div class="container-page flex min-h-[76px] items-center justify-between gap-6 py-3">
			{data.hinweis && <p class="hidden max-w-[70ch] font-medium text-heading sm:block" data-tina-field={tinaField(data, 'hinweis')}>{data.hinweis}</p>}
			{knopf?.link && <a href={knopf.link} class="btn-primary w-full sm:w-auto sm:shrink-0" data-tina-field={tinaField(knopf)}>{knopf.label}</a>}
		</div>
	</aside>
)}

