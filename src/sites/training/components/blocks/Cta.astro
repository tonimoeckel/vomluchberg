---
// Call to action on the fir field, edge to edge: the head on seven columns, the line and the buttons
// on five (shared cta template: titel, text, buttons).
import { tinaField } from '@tinacms/astro/tina-field';
import type { BlockOf } from '../../lib/data';
interface Props { data: BlockOf<'Cta'> }
const { data } = Astro.props;
const buttons = (data.buttons ?? []).filter((b) => b !== null);
---
<section class="band-field sektion">
	<div class="container-page grid gap-x-[var(--gap-columns)] gap-y-8 lg:grid-cols-12 lg:items-end">
		{data.titel && <h2 class="display text-section lg:col-span-7" data-tina-field={tinaField(data, 'titel')}>{data.titel}</h2>}
		<div class="lg:col-span-5">
			{data.text && <p class="max-w-[48ch] text-lead leading-snug text-on-dark-muted" data-tina-field={tinaField(data, 'text')}>{data.text}</p>}
			{buttons.length > 0 && (
				<div class="mt-8 flex flex-wrap gap-3">
					{buttons.map((b) => (
						<a data-tina-field={tinaField(b)} href={b.link} rel={b.link?.startsWith('http') ? 'noopener' : undefined}
							class={b.stil === 'sekundaer' ? 'btn-hell' : 'btn-primary'}>{b.label}</a>
					))}
				</div>
			)}
		</div>
	</div>
</section>
