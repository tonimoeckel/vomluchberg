---
// Vita as ruled rows: the time set as a figure on three columns, the title and the line beside it.
import { tinaField } from '@tinacms/astro/tina-field';
import SectionHead from '../SectionHead.astro';
import type { BlockOf } from '../../lib/data';

interface Props { data: BlockOf<'Zeitstrahl'> }
const { data } = Astro.props;
const stationen = (data.stationen ?? []).filter((s) => s !== null);
---
<section class="sektion-m">
	<div class="container-page">
		<SectionHead data={data} geteilt class="mb-14" />
		<ol class="regel" data-tina-field={tinaField(data, 'stationen')}>
			{stationen.map((s) => (
				<li class="grid gap-x-[var(--gap-columns)] gap-y-2 border-b border-border py-7 md:grid-cols-12 md:items-baseline" data-tina-field={tinaField(s)}>
					{s.zeit && <p class="figur text-[clamp(1.75rem,1.5vw+1.25rem,2.5rem)] uppercase text-accent md:col-span-3">{s.zeit}</p>}
					{s.titel && <h3 class="display text-title md:col-span-4">{s.titel}</h3>}
					{s.beschreibung && <p class="max-w-[52ch] text-muted md:col-span-5">{s.beschreibung}</p>}
				</li>
			))}
		</ol>
	</div>
</section>
