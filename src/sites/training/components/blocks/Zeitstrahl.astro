---
// Vita as a timeline: horizontal "lane" with stations on wide screens, vertical on phones.
import { tinaField } from '@tinacms/astro/tina-field';
import SectionHead from '../SectionHead.astro';
import type { BlockOf } from '../../lib/data';

interface Props { data: BlockOf<'Zeitstrahl'> }
const { data } = Astro.props;
const stationen = (data.stationen ?? []).filter((s) => s !== null);
---
<section class="py-14 sm:py-20">
	<div class="container-page">
		<SectionHead data={data} />
		<ol class="relative mt-10 grid gap-8 border-l-4 border-lane pl-6 lg:grid-flow-col lg:auto-cols-fr lg:gap-6 lg:border-l-0 lg:border-t-4 lg:pl-0 lg:pt-8" data-tina-field={tinaField(data, 'stationen')}>
			{stationen.map((s) => (
				<li class="relative" data-tina-field={tinaField(s)}>
					<span class="absolute -left-[34px] top-1.5 size-4 rounded-full border-4 border-bg bg-copper lg:-top-[44px] lg:left-0" aria-hidden="true"></span>
					{s.zeit && <p class="font-display text-[0.95rem] font-semibold uppercase tracking-[0.14em] text-primary-ink">{s.zeit}</p>}
					{s.titel && <h3 class="display mt-1 text-[1.7rem] leading-[1.05]">{s.titel}</h3>}
					{s.beschreibung && <p class="mt-2 text-[0.98rem] text-muted">{s.beschreibung}</p>}
				</li>
			))}
		</ol>
	</div>
</section>
