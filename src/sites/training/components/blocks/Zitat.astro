---
// A quote of Karo's on the fir field: her own words set large across ten columns, her name beneath.
// With a photo, the photo takes three columns beside it.
import { tinaField } from '@tinacms/astro/tina-field';
import type { BlockOf } from '../../lib/data';

interface Props { data: BlockOf<'Zitat'> }
const { data } = Astro.props;
const text = data.zitat?.replace(/^[„"“]|[“"”]$/g, '');
---
<section class="band-field sektion">
	<figure class="container-page grid gap-x-[var(--gap-columns)] gap-y-8 lg:grid-cols-12 lg:items-center">
		{data.bild && <img src={data.bild} alt="" width="600" height="600" loading="lazy" class="foto aspect-square max-w-[280px] lg:col-span-3 lg:max-w-none" data-tina-field={tinaField(data, 'bild')} />}
		<div class:list={[data.bild ? 'lg:col-span-8 lg:col-start-5' : 'lg:col-span-10']}>
			{text && (
				<blockquote data-tina-field={tinaField(data, 'zitat')}>
					<p class="text-[clamp(1.625rem,1.6vw+1.1rem,2.5rem)] font-medium leading-[1.3] text-on-dark [hanging-punctuation:first]">„{text}“</p>
				</blockquote>
			)}
			{data.autor && <figcaption class="mt-8 border-t-2 border-on-dark pt-4 text-lg font-medium text-on-dark-muted" data-tina-field={tinaField(data, 'autor')}>{data.autor}</figcaption>}
		</div>
	</figure>
</section>
