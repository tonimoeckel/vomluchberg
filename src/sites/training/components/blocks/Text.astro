---
// Text with optional photo, tags and buttons. With a photo: a split, the photo on five columns
// (portrait), the text on six; without one: the head beside the text. Background light, sand
// (paper-2) or dark (the night band).
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import SectionHead from '../SectionHead.astro';
import type { BlockOf } from '../../lib/data';

interface Props { data: BlockOf<'Text'> }
const { data } = Astro.props;
const dunkel = data.hintergrund === 'dunkel';
const hg = dunkel ? 'band-night' : data.hintergrund === 'sand' ? 'bg-surface' : '';
const stichworte = (data.stichworte ?? []).filter(Boolean);
const buttons = (data.buttons ?? []).filter((b) => b !== null);
const links = data.bildPosition === 'links';
const nurText = !data.bild && !data.ueberschrift;
---
<section class:list={[nurText ? 'pt-12 pb-[var(--section-gap-s)]' : 'sektion', hg]}>
	<div class="container-page grid gap-x-[var(--gap-columns)] gap-y-10 lg:grid-cols-12 lg:items-center">
		{data.bild && (
			<figure class:list={['lg:col-span-5', links ? 'lg:col-start-1 lg:row-start-1' : 'lg:col-start-8']} data-tina-field={tinaField(data, 'bild')}>
				<img src={data.bild} alt={data.bildunterschrift ?? ''} width="900" height="1125" loading="lazy" decoding="async" class="foto aspect-[4/5] max-h-[680px]" />
				{data.bildunterschrift && <figcaption class="mt-3 text-[0.9375rem] text-muted">{data.bildunterschrift}</figcaption>}
			</figure>
		)}
		<div class:list={[
			data.bild ? ['lg:col-span-6 lg:row-start-1', links ? 'lg:col-start-7' : 'lg:col-start-1'] : 'lg:col-span-12',
			!data.bild && data.ueberschrift && 'grid gap-x-[var(--gap-columns)] gap-y-6 lg:grid-cols-12',
		]}>
			<SectionHead data={data} class:list={[data.bild ? 'mb-8' : 'lg:col-span-5']} />
			<div class:list={[!data.bild && data.ueberschrift && 'lg:col-span-7']}>
				{data.inhalt && (
					<div class:list={['prose prose-lg prose-site', dunkel && 'prose-hell']} data-tina-field={tinaField(data, 'inhalt')}>
						<TinaMarkdown content={data.inhalt} />
					</div>
				)}
				{stichworte.length > 0 && (
					<ul class="mt-8 flex flex-wrap gap-2" aria-label="Schwerpunkte" data-tina-field={tinaField(data, 'stichworte')}>
						{stichworte.map((s) => <li class="tag">{s}</li>)}
					</ul>
				)}
				{buttons.length > 0 && (
					<div class="mt-10 flex flex-wrap gap-3">
						{buttons.map((b) => (
							<a data-tina-field={tinaField(b)} href={b.link} rel={b.link?.startsWith('http') ? 'noopener' : undefined}
								class={b.stil === 'sekundaer' ? (dunkel ? 'btn-hell' : 'btn-secondary') : 'btn-primary'}>{b.label}</a>
						))}
					</div>
				)}
			</div>
		</div>
	</div>
</section>
