---
// Inquiry section on paper-2 (the "ticket desk"): the head and the contact details on five columns,
// the form on seven. Preselects ?angebot=<slug>.
import SectionHead from '../SectionHead.astro';
import Kontaktliste from '../Kontaktliste.astro';
import AnfrageFormular from '../AnfrageFormular.astro';
import { getConfig, listAngeboteMitSlug, type BlockOf } from '../../lib/data';

interface Props { data: BlockOf<'Anfrage'> }
const { data } = Astro.props;
const config = (await getConfig()).data?.trainingConfig;
const angebote = await listAngeboteMitSlug();
---
<section class="sektion bg-surface" id="anfrage">
	<div class="container-page grid items-start gap-x-[var(--gap-columns)] gap-y-12 lg:grid-cols-12">
		<div class="lg:col-span-5">
			<SectionHead data={data} />
			{data.kontaktZeigen && <Kontaktliste config={config} />}
		</div>
		<div class="lg:col-span-7">
			<AnfrageFormular angebote={angebote} config={config} />
		</div>
	</div>
</section>
