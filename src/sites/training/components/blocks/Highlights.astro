---
// Facts and lists in four looks, all ruled, never boxed (Piste):
// "band"     the facts row: four facts across under a 2px ink rule, parted by hairlines
// "schritte" the process as ruled rows under the head: a real <ol>, each stage a numeral, a title, a line.
//            On the way down the numeral lights up in the signal colour as its row reaches the middle of
//            the screen and a line grows to the next stage (scroll-driven, see the <style> below)
// "werte"    two columns of numbered values, each under its own ink rule
// "kacheln"  three across, an icon inline before each title, under a hairline
import { tinaField } from '@tinacms/astro/tina-field';
import Icon from '../../../../components/ui/Icon.astro';
import SectionHead from '../SectionHead.astro';
import type { BlockOf } from '../../lib/data';

interface Props { data: BlockOf<'Highlights'> }
const { data } = Astro.props;
const items = (data.items ?? []).filter((i) => i !== null);
const darstellung = data.darstellung ?? 'kacheln';
---
{darstellung === 'band' ? (
	<section class="pt-20 pb-4 sm:pt-24 sm:pb-6">
		<div class="container-page">
			<SectionHead data={data} class="mb-10" />
			<ul class="regel grid sm:grid-cols-2 lg:grid-cols-4">
				{items.map((it, i) => (
					<li class:list={['grid content-start gap-1.5 border-border py-6 sm:pr-8', i > 0 && 'max-sm:haar', i % 2 === 1 && 'sm:border-l sm:pl-8', i > 1 && 'sm:max-lg:haar', i === 2 && 'lg:border-l lg:pl-8']} data-tina-field={tinaField(it)}>
						<b class="display block text-title">{it.titel}</b>
						{it.text && <span class="text-muted">{it.text}</span>}
					</li>
				))}
			</ul>
		</div>
	</section>
) : darstellung === 'schritte' ? (
	<section class="sektion">
		<div class="container-page">
			<SectionHead data={data} geteilt class="mb-14" />
			<ol class="regel schritte">
				{items.map((it, i) => (
					<li class="grid grid-cols-[4.5rem_minmax(0,1fr)] gap-x-6 border-b border-border py-8 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-x-8" data-tina-field={tinaField(it)}>
						<span class="schritt-nr figur relative text-[clamp(3.5rem,4vw+1.5rem,6rem)] leading-[0.85] text-accent" data-n={i + 1} aria-hidden="true">{i + 1}</span>
						<span class="self-center">
							<h3 class="display text-title">{it.titel}</h3>
							{it.text && <p class="mt-2 max-w-[60ch] text-lg text-fg">{it.text}</p>}
						</span>
					</li>
				))}
			</ol>
		</div>
	</section>
) : (
	<section class="sektion">
		<div class="container-page">
			<SectionHead data={data} geteilt class="mb-14" />
			{darstellung === 'werte' && (
				<ol class="grid gap-x-[var(--gap-columns)] gap-y-10 md:grid-cols-2">
					{items.map((it, i) => (
						<li class="regel grid grid-cols-[4.5rem_minmax(0,1fr)] gap-x-6 pt-6 sm:grid-cols-[6rem_minmax(0,1fr)]" data-tina-field={tinaField(it)}>
							<span class="figur text-[clamp(3.5rem,3vw+2rem,5.25rem)] leading-[0.85] text-accent" aria-hidden="true">{i + 1}</span>
							<span>
								<h3 class="display text-[clamp(1.875rem,1.5vw+1.25rem,2.75rem)]">{it.titel}</h3>
								{it.text && <p class="mt-2 text-lg text-fg">{it.text}</p>}
							</span>
						</li>
					))}
				</ol>
			)}
			{darstellung === 'kacheln' && (
				<ul class="grid gap-x-[var(--gap-columns)] gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
					{items.map((it) => (
						<li class="haar pt-5" data-tina-field={tinaField(it)}>
							<h3 class="display flex items-start gap-3 text-title">
								{it.icon && <Icon name={it.icon} class="mt-[0.15em] size-6 shrink-0 text-accent" aria-hidden="true" />}
								<span>{it.titel}</span>
							</h3>
							{it.text && <p class="mt-2 text-muted">{it.text}</p>}
						</li>
					))}
				</ul>
			)}
		</div>
	</section>
)}

<style>
	/* "schritte": a step counts as reached when its numeral passes the middle of the screen. A copy of
	   the numeral in the signal colour (--primary-ink, AA on paper in every scheme) fades in over it,
	   then a line grows to the next numeral: down the number column on phones, along the row's
	   hairline on wide screens. Only opacity and transform; the subject is the row (view()), ranges in
	   "entry" offsets: entry 0 = row top at the bottom of the screen, 100% = one row height further.
	   Without support or with reduced motion nothing is drawn and the list looks as it always did. */
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.schritte > li {
				position: relative;
				--mitte: calc(50vh + 2.5rem); /* the numeral starts 2rem below the row top: lit once it touches the middle */
			}
			.schritt-nr::before {
				content: attr(data-n);
				position: absolute;
				inset: 0;
				color: var(--primary-ink);
				opacity: 0;
				animation: schritt-erreicht linear both;
				animation-timeline: view();
				animation-range: entry calc(var(--mitte) - 2.5rem) entry var(--mitte);
			}
			.schritte > li:not(:last-child)::after {
				content: '';
				position: absolute;
				background: var(--primary);
				pointer-events: none;
				animation: schritt-weg linear both;
				animation-timeline: view();
				animation-range: entry var(--mitte) entry calc(100% + var(--mitte));
			}
			/* Phones: down the number column, from under this numeral to just above the next one. */
			@media (max-width: 39.999rem) {
				.schritte > li:not(:last-child)::after {
					--schritt-achse: scaleY(0);
					left: 1rem;
					top: 5.5rem;
					bottom: -1.5rem;
					width: 2px;
					transform: scaleY(0);
					transform-origin: top;
				}
			}
			/* Wide screens: along the hairline under the row, left to right. */
			@media (min-width: 40rem) {
				.schritte > li:not(:last-child)::after {
					--schritt-achse: scaleX(0);
					inset-inline: 0;
					bottom: -1px;
					height: 2px; /* over the hairline, as thick as the inquiry bar's line */
					transform: scaleX(0);
					transform-origin: left;
				}
			}
		}
	}
	@keyframes schritt-erreicht {
		to { opacity: 1; }
	}
	@keyframes schritt-weg {
		from { transform: var(--schritt-achse); }
		to { transform: none; }
	}
</style>
