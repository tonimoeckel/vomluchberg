---
// Automatic list of the visible offers (filter: all / group / single).
import { tinaField } from '@tinacms/astro/tina-field';
import SectionHead from '../SectionHead.astro';
import AngebotKarte from '../AngebotKarte.astro';
import { angeboteListeUrl, sichtbareAngebote } from '../../../../lib/domain/angebot';
import { listAngeboteMitSlug, type BlockOf } from '../../lib/data';

interface Props { data: BlockOf<'Angebote'> }
const { data } = Astro.props;
const angebote = sichtbareAngebote(await listAngeboteMitSlug(), data.auswahl);
---
<section class="py-14 sm:py-20" id="angebote">
	<div class="container-page">
		<div class="mb-10 flex flex-wrap items-end justify-between gap-6">
			<SectionHead data={data} />
			{data.alleLink && <a href={angeboteListeUrl} class="textlink" data-tina-field={tinaField(data, 'alleLink')}>Alle Angebote →</a>}
		</div>
		{angebote.length > 0 ? (
			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				{angebote.map((a, i) => <AngebotKarte angebot={a} nummer={i + 1} />)}
			</div>
		) : (
			<p class="text-muted">Gerade sind keine Angebote eingetragen. Schreibt mir gern trotzdem eine Anfrage.</p>
		)}
	</div>
</section>
