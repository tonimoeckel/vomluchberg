---
// Training ground, e-mail (phone only when set) and Instagram, as shown next to the inquiry form.
import { tinaField } from '@tinacms/astro/tina-field';
import Icon from '../../../components/ui/Icon.astro';
import type { CmsConfig } from '../lib/data';

interface Props { config?: CmsConfig | null }
const { config } = Astro.props;
const k = config?.kontakt;
const s = config?.social;
const titel = 'block font-display text-xl font-extrabold uppercase tracking-[0.02em] text-heading';
const link = 'text-muted underline decoration-copper underline-offset-2 hover:text-primary-ink';
---
{k && (
	<ul class="mt-8 grid gap-5" data-tina-field={config ? tinaField(config, 'kontakt') : undefined}>
		<li class="flex items-start gap-3.5">
			<span class="flex size-11 shrink-0 items-center justify-center rounded-card bg-dark text-on-dark"><Icon name="map-pin" class="size-6" /></span>
			<span class="text-[0.97rem] text-muted">
				<b class={titel}>{k.ortName || 'Trainingsort'}</b>
				{[k.strasse, k.ort].filter(Boolean).join(', ')}
				{k.ortText && <span class="block">{k.ortText}</span>}
				{k.mapsLink && <a href={k.mapsLink} rel="noopener" class={link}>In Google Maps öffnen</a>}
			</span>
		</li>
		{k.email && (
			<li class="flex items-start gap-3.5">
				<span class="flex size-11 shrink-0 items-center justify-center rounded-card bg-dark text-on-dark"><Icon name="mail" class="size-6" /></span>
				<span><b class={titel}>E-Mail</b><a href={`mailto:${k.email}`} class:list={[link, 'break-all']}>{k.email}</a></span>
			</li>
		)}
		{k.telefon && (
			<li class="flex items-start gap-3.5">
				<span class="flex size-11 shrink-0 items-center justify-center rounded-card bg-dark text-on-dark"><Icon name="phone" class="size-6" /></span>
				<span><b class={titel}>Telefon</b><a href={`tel:${k.telefon.replace(/[^+\d]/g, '')}`} class={link}>{k.telefon}</a></span>
			</li>
		)}
		{s?.instagram && (
			<li class="flex items-start gap-3.5" data-tina-field={tinaField(s, 'instagram')}>
				<span class="flex size-11 shrink-0 items-center justify-center rounded-card bg-dark text-on-dark"><Icon name="brand-instagram" class="size-6" /></span>
				<span><b class={titel}>Instagram</b><a href={s.instagram} rel="noopener" class={link}>{s.instagramName || 'Instagram'}</a></span>
			</li>
		)}
	</ul>
)}
