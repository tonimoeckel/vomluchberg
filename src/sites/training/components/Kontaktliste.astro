---
// Where and how to reach Karo, next to the inquiry form. The training place opens as a notebook card
// (the one lifted surface) on the survey sketch of the Luchberg; e-mail, phone (only when set) and
// Instagram follow as a ruled list (dl). Icons inline, never in a tile. The kinds of training places
// (kontakt.orte, defaults in lib/orte.ts) are pins on the map and, for screen readers, a list in the card.
import { tinaField } from '@tinacms/astro/tina-field';
import Icon from '../../../components/ui/Icon.astro';
import Karte from './Karte.astro';
import { orte } from '../lib/orte';
import type { CmsConfig } from '../lib/data';

interface Props { config?: CmsConfig | null }
const { config } = Astro.props;
const k = config?.kontakt;
const s = config?.social;
const zeile = 'grid grid-cols-[1.5rem_minmax(0,1fr)] gap-x-3 border-b border-border py-5';
const titel = 'font-display text-[1.25rem] font-semibold leading-tight text-heading';
const icon = 'mt-0.5 size-6 text-accent';
const treffpunkte = orte(k?.orte);
---
{k && (
	<div class="mt-10" data-tina-field={config ? tinaField(config, 'kontakt') : undefined}>
		<figure>
			<div class="relative overflow-hidden rounded-[var(--radius)] border border-border bg-bg">
				<Karte beschriftet orte={treffpunkte} class="aspect-square h-auto sm:aspect-[4/3]" />
			</div>
			<div class="notiz relative -mt-14 ml-6 mr-3 sm:ml-16 sm:mr-6">
				<div class="flex items-center gap-3 bg-heading px-5 py-3 text-bg">
					<Icon name="map-pin" class="size-5 shrink-0" aria-hidden="true" />
					<p class="font-medium">{k.ortName || 'Trainingsort'}</p>
				</div>
				<div class="px-5 py-5">
					<p class="font-medium text-heading">{[k.ort, k.region].filter(Boolean).join(', ')}</p>
					{k.strasse && <p class="text-muted">{k.strasse}</p>}
					{k.ortText && <p class="mt-2 max-w-[52ch] text-fg">{k.ortText}</p>}
					<ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2" aria-label="Mögliche Treffpunkte" data-tina-field={k.orte ? tinaField(k, 'orte') : undefined}>
						{treffpunkte.map((o) => (
							<li class="flex items-center gap-2 font-medium text-heading">
								<svg viewBox="-34 -58 68 68" class="size-5 shrink-0 text-primary-ink" aria-hidden="true" focusable="false">
									{o.art === 'vorOrt' && <circle cy="-24" r="31" fill="none" stroke="currentColor" stroke-width="3" stroke-dasharray="6 5" />}
									<path d="M0 0C-5-13-18-22-18-35a18 18 0 1 1 36 0c0 13-13 22-18 35z" fill="currentColor" />
								</svg>
								{o.name}
							</li>
						))}
					</ul>
					{k.mapsLink && <a href={k.mapsLink} rel="noopener" class="textlink mt-3 inline-block">In Google Maps öffnen</a>}
				</div>
			</div>
			<figcaption class="mt-3 text-[0.9375rem] text-muted">Skizze, nicht maßstabsgetreu: der Luchberg über dem Müglitztal. Die Treffpunkte sind nur angedeutet.</figcaption>
		</figure>
		<dl class="regel mt-8">
			{k.email && (
				<div class={zeile}>
					<Icon name="mail" class={icon} aria-hidden="true" />
					<div><dt class={titel}>E-Mail</dt><dd class="mt-1"><a href={`mailto:${k.email}`} class="textlink break-all">{k.email}</a></dd></div>
				</div>
			)}
			{k.telefon && (
				<div class={zeile}>
					<Icon name="phone" class={icon} aria-hidden="true" />
					<div><dt class={titel}>Telefon</dt><dd class="mt-1"><a href={`tel:${k.telefon.replace(/[^+\d]/g, '')}`} class="textlink">{k.telefon}</a></dd></div>
				</div>
			)}
			{s?.instagram && (
				<div class={zeile} data-tina-field={tinaField(s, 'instagram')}>
					<Icon name="brand-instagram" class={icon} aria-hidden="true" />
					<div><dt class={titel}>Instagram</dt><dd class="mt-1"><a href={s.instagram} rel="noopener" class="textlink">{s.instagramName || 'Instagram'}</a></dd></div>
				</div>
			)}
		</dl>
	</div>
)}
