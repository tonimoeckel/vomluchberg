---
/**
 * Preview entry of the "Rückruf" game (docs/plan/04-rueckruf-spiel.md), for showing it to Karo
 * before it is offered after an inquiry: `?rueckruf` (or `?rueckruf=welpe|junghund|pruefung`) on
 * any page opens it. The game is its own chunk (lib/rueckruf/spiel.ts) and is only fetched with
 * the parameter, so normal pages carry just this loader.
 */
---
<script>
	const wunsch = new URLSearchParams(location.search).get('rueckruf');
	if (wunsch !== null) import('../lib/rueckruf/spiel').then((m) => m.oeffnen(wunsch));
</script>
