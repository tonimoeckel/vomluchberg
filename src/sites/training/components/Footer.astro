---
// Footer of the training site, a letter close on the night band, the survey sketch behind it: the closing line large with Karo's
// name beneath it, then pages, contact and the hint to the Rottweiler kennel (D7), then the legal line.
import { tinaField } from '@tinacms/astro/tina-field';
import Karte from './Karte.astro';
import Logo from './Logo.astro';
import type { CmsConfig } from '../lib/data';

interface Props { config?: CmsConfig | null }
const { config } = Astro.props;
const w = config?.website;
const k = config?.kontakt;
const s = config?.social;
const q = config?.querverweis;
const nav = (config?.nav ?? []).filter((n) => n !== null);
const jahr = new Date().getFullYear();
const link = 'text-on-dark underline-offset-[0.2em] hover:underline';
const titel = 'mb-4 font-sans text-[0.9375rem] font-medium normal-case tracking-normal text-on-dark-muted';
---
<footer class="band-night relative isolate overflow-hidden border-t-[6px] border-bg pt-20 pb-10 sm:pt-24">
	<Karte gipfel={false} class="karte-ausblenden absolute inset-x-0 top-0 -z-10 h-[420px] opacity-70" />
	<div class="container-page">
		<div class="grid gap-x-[var(--gap-columns)] gap-y-10 lg:grid-cols-12 lg:items-end">
			<div class="lg:col-span-8">
				{w?.fusszeile && <p class="max-w-[30ch] text-[clamp(1.5rem,1.4vw+1rem,2.25rem)] font-medium leading-snug text-on-dark" data-tina-field={tinaField(w, 'fusszeile')}>{w.fusszeile}</p>}
				{k?.name && <p class="mt-6 font-display text-[1.75rem] font-semibold leading-none text-on-dark">{k.name}</p>}
			</div>
			<a href="/" aria-label="Alltag kann Sport – Startseite" class="inline-block justify-self-start lg:col-span-4 lg:justify-self-end"><Logo website={w} hell class="h-20 w-auto" /></a>
		</div>

		<div class="mt-16 grid gap-x-[var(--gap-columns)] gap-y-10 border-t border-on-dark pt-8 sm:grid-cols-2 lg:grid-cols-12">
			{nav.length > 0 && (
				<nav aria-label="Seiten" class="lg:col-span-3">
					<h2 class={titel}>Seiten</h2>
					<ul class="grid gap-2" data-tina-field={config ? tinaField(config, 'nav') : undefined}>
						{nav.map((n) => <li><a href={n.link} class={link}>{n.titel}</a></li>)}
					</ul>
				</nav>
			)}
			{k && (
				<div class="lg:col-span-4">
					<h2 class={titel}>Kontakt</h2>
					<ul class="grid gap-2 text-on-dark" data-tina-field={tinaField(config!, 'kontakt')}>
						{(k.strasse || k.ort) && <li>{[k.strasse, k.ort].filter(Boolean).join(', ')}</li>}
						{k.telefon && <li><a class={link} href={`tel:${k.telefon.replace(/[^+\d]/g, '')}`}>{k.telefon}</a></li>}
						{k.email && <li><a class={link} href={`mailto:${k.email}`}>E-Mail schreiben</a></li>}
						{s?.instagram && <li data-tina-field={tinaField(s, 'instagram')}><a class={link} href={s.instagram} rel="noopener">Instagram</a></li>}
					</ul>
				</div>
			)}
			{q?.link && (
				<div class="sm:col-span-2 lg:col-span-5" data-tina-field={tinaField(q)}>
					<h2 class={titel}>Rottweiler</h2>
					<p class="max-w-[40ch] text-on-dark">{q.text}</p>
					<p class="mt-2"><a href={q.link} rel="noopener" class:list={[link, 'font-medium underline']}>{q.linkText || q.link}</a></p>
				</div>
			)}
		</div>

		<div class="mt-16 flex flex-wrap justify-between gap-x-8 gap-y-3 border-t border-border pt-6 text-[0.9375rem] text-on-dark-muted">
			<span>© {jahr} {w?.name}</span>
			<span class="flex gap-6"><a href="/impressum" class={link}>Impressum</a><a href="/datenschutz" class={link}>Datenschutz</a></span>
		</div>
	</div>
</footer>
