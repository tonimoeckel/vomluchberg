---
// "Was ihr davon habt": a ruled field of outcomes, three across on wide screens, two on tablets. Each
// cell has its symbol set large in the signal colour above the title, hairlines between the cells
// (a survey table, not cards).
import { tinaField } from '@tinacms/astro/tina-field';
import Icon from '../../../../components/ui/Icon.astro';
import SectionHead from '../SectionHead.astro';
import type { AbschnittOf } from '../../lib/data';

interface Props { data: AbschnittOf<'Vorteile'> }
const { data } = Astro.props;
const vorteile = (data.vorteile ?? []).filter((v) => v !== null);
---
<section class="sektion-m">
	<div class="container-page">
		<SectionHead data={data} geteilt class="mb-14" />
		<ul class="vorteile regel grid sm:grid-cols-2 lg:grid-cols-3" data-tina-field={tinaField(data, 'vorteile')}>
			{vorteile.map((v) => (
				<li class="vorteil grid content-start gap-3 border-b border-border py-8 sm:px-8" data-tina-field={tinaField(v)}>
					{v.icon && <Icon name={v.icon} class="size-10 text-[var(--signal)]" aria-hidden="true" />}
					<h3 class="display text-title">{v.titel}</h3>
					{v.beschreibung && <p class="text-fg">{v.beschreibung}</p>}
				</li>
			))}
		</ul>
	</div>
</section>
