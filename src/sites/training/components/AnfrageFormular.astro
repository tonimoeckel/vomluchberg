---
/**
 * Inquiry form of the training site (docs/plan/02-training.md §5). Every call to action leads here:
 * there is no booking. With PUBLIC_WEB3FORMS_KEY the form posts to Web3Forms (JS: fetch + status
 * text; without JS: plain POST), otherwise it opens the visitor's mail program (mailto: with all
 * fields). The offer is preselected server-side (`vorausgewaehlt`, detail pages) or from
 * `?angebot=<slug>` in the browser (/anfrage). Field names: anfrageFelder in src/lib/domain/anfrage.ts.
 */
import { tinaField } from '@tinacms/astro/tina-field';
import { anfrageFelder as f, anfrageOptionen, vorauswahl, wunschzeiten } from '../../../lib/domain/anfrage';
import type { AngebotListItem, CmsConfig } from '../lib/data';

interface Props {
	angebote: readonly AngebotListItem[];
	config?: CmsConfig | null;
	/** Slug of the offer to preselect (detail pages). Without it, ?angebot= in the URL decides. */
	vorausgewaehlt?: string;
}
const { angebote, config, vorausgewaehlt } = Astro.props;
const optionen = anfrageOptionen(angebote);
const auswahl = vorauswahl(vorausgewaehlt, optionen);
const email = config?.kontakt?.email ?? '';
const anfrage = config?.anfrage;
const web3key = import.meta.env.PUBLIC_WEB3FORMS_KEY;
// Without a form service and without JS, the browser's mail program gets the fields as plain text.
const action = web3key ? 'https://api.web3forms.com/submit' : email ? `mailto:${email}` : undefined;
const legende = 'mb-5 flex items-baseline gap-3 p-0 font-display text-[1.625rem] font-semibold leading-none text-heading';
const nummer = 'figur text-accent';
const label = 'grid gap-2 text-[0.9375rem] font-medium text-heading';
---
<form id="formular" method="post" action={action} enctype={web3key ? undefined : 'text/plain'}
	class="regel grid scroll-mt-28 gap-10 pt-8"
	data-anfrage data-mail={email} data-optionen={JSON.stringify(optionen)} data-url-vorauswahl={vorausgewaehlt ? undefined : ''}
	data-danke={anfrage?.danke ?? 'Danke! Eure Anfrage ist angekommen – ich melde mich persönlich bei euch.'}>
	{web3key && <input type="hidden" name="access_key" value={web3key} />}
	{web3key && <input type="hidden" name="subject" value="Neue Trainingsanfrage über die Website" />}
	{web3key && <input type="hidden" name="from_name" value="Alltag kann Sport Website" />}
	<input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

	<fieldset class="grid gap-5">
		<legend class={legende}><span class={nummer} aria-hidden="true">1</span>Welches Training?</legend>
		<label class={label}>Angebot *
			<select required name={f.angebot} class="feld">
				<option value="" selected={!auswahl}>Bitte wählen …</option>
				{optionen.map((o) => <option value={o.value} selected={o.value === auswahl}>{o.label}</option>)}
			</select>
		</label>
	</fieldset>

	<fieldset class="grid gap-5">
		<legend class={legende}><span class={nummer} aria-hidden="true">2</span>Über euch</legend>
		<div class="grid gap-4 sm:grid-cols-2">
			<label class={label}>Name *<input required name={f.name} autocomplete="name" class="feld" /></label>
			<label class={label}>E-Mail *<input required type="email" name={f.email} autocomplete="email" class="feld" /></label>
		</div>
		<label class={label}>Telefon (optional, für einen Rückruf)<input type="tel" name={f.telefon} autocomplete="tel" class="feld" /></label>
	</fieldset>

	<fieldset class="grid gap-5">
		<legend class={legende}><span class={nummer} aria-hidden="true">3</span>Über euren Hund</legend>
		<div class="grid gap-4 sm:grid-cols-[1.2fr_1fr_0.8fr]">
			<label class={label}>Name<input name={f.hundName} class="feld" /></label>
			<label class={label}>Rasse / Mix<input name={f.hundRasse} class="feld" /></label>
			<label class={label}>Alter<input name={f.hundAlter} placeholder="z. B. 4 Monate" class="feld" /></label>
		</div>
		<label class={label}>Was wünscht ihr euch vom Training? *
			<textarea required name={f.nachricht} rows="4" class="feld"
				placeholder="z. B. Leinenführigkeit, Begegnungen mit anderen Hunden, Einstieg in den Hundesport …"></textarea>
		</label>
	</fieldset>

	<fieldset class="grid gap-5">
		<legend class={legende}><span class={nummer} aria-hidden="true">4</span>Wann passt es euch?</legend>
		<div class="flex flex-wrap gap-2" role="group" aria-label="Wunschzeiten">
			{wunschzeiten.map((z) => (
				<label class="cursor-pointer">
					<input type="checkbox" name={f.zeiten} value={z} class="peer sr-only" />
					<span class="inline-flex min-h-11 items-center rounded-[var(--radius)] border border-muted bg-card px-4 text-[0.9375rem] font-medium text-heading hover:border-heading active:bg-surface peer-disabled:cursor-not-allowed peer-disabled:opacity-55 peer-checked:border-heading peer-checked:bg-heading peer-checked:text-bg peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary">{z}</span>
				</label>
			))}
		</div>
		<label class={label}>Sonstiges zu Zeiten (optional)<input name={f.zeitenText} placeholder="z. B. ab Mitte Mai, nicht mittwochs" class="feld" /></label>
	</fieldset>

	<label class="flex items-start gap-3 text-[0.9375rem] text-muted">
		<input required type="checkbox" name="datenschutz" value="ja" class="mt-0.5 size-5 shrink-0 accent-[var(--primary)]" />
		<span>Ich bin einverstanden, dass meine Angaben zur Beantwortung meiner Anfrage verwendet werden. Mehr in der <a href="/datenschutz" class="textlink">Datenschutzerklärung</a>. *</span>
	</label>
	<div>
		<button type="submit" class="btn-primary">Anfrage senden</button>
		{!web3key && <p class="mt-3 text-[0.9375rem] text-muted">Beim Absenden öffnet sich euer E-Mail-Programm mit der fertigen Nachricht.</p>}
	</div>
	{anfrage?.hinweis && <p class="-mt-6 text-[0.9375rem] text-muted" data-tina-field={tinaField(anfrage, 'hinweis')}>{anfrage.hinweis}</p>}
	<p role="status" data-status class="text-lg font-medium text-heading empty:hidden"></p>
</form>

<script>
	import { anfrageAusFormular, anfrageBetreff, anfrageMailto, vorauswahl, type AnfrageOption } from '../../../lib/domain/anfrage';

	for (const form of document.querySelectorAll<HTMLFormElement>('form[data-anfrage]')) {
		const optionen: AnfrageOption[] = JSON.parse(form.dataset.optionen ?? '[]');
		const select = form.elements.namedItem('angebot') as HTMLSelectElement | null;
		const status = form.querySelector<HTMLElement>('[data-status]')!;
		const mail = form.dataset.mail ?? '';

		// /anfrage?angebot=<slug>: preselect a known offer, ignore anything else.
		if (select && form.dataset.urlVorauswahl !== undefined) {
			const wert = vorauswahl(new URLSearchParams(location.search).get('angebot'), optionen);
			if (wert) select.value = wert;
		}

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const daten = anfrageAusFormular(new FormData(form));
			const ziel = form.getAttribute('action') ?? '';
			if (!ziel.startsWith('https://')) {
				// No form service configured: open the mail program with every field filled in.
				location.href = anfrageMailto(mail, daten, optionen);
				return;
			}
			const body = new FormData(form);
			body.set('subject', anfrageBetreff(daten, optionen));
			status.textContent = 'Wird gesendet …';
			try {
				const r = await fetch(ziel, { method: 'POST', headers: { Accept: 'application/json' }, body });
				const j = await r.json();
				if (!j.success) throw new Error(j.message);
				form.reset();
				status.textContent = form.dataset.danke ?? '';
			} catch {
				status.textContent = `Das hat leider nicht geklappt. Schreibt mir bitte direkt an ${mail}.`;
			}
		});
	}
</script>
