---
// One offer as a row of the price list: the photo, the title and what it is, the facts as tags, the
// price set large and the inquiry button. Rows are parted by hairlines; the list opens on a 2px ink rule.
import { tinaField } from '@tinacms/astro/tina-field';
import { anfrageUrl, angebotFakten, angebotUrl, artLabel, formatEuro, preisEinheiten } from '../../../lib/domain/angebot';
import type { AngebotListItem } from '../lib/data';

interface Props { angebot: AngebotListItem; ueberschrift?: 'h2' | 'h3' }
const { angebot: a, ueberschrift: H = 'h3' } = Astro.props;
const preisSichtbar = a.preis != null && a.preisAnzeigen !== false;
const einheit = preisEinheiten.find((e) => e.value === a.preisEinheit)?.label ?? 'Termin';
const url = angebotUrl(a.slug);
const art = artLabel(a.art);
---
<article class="grid gap-x-[var(--gap-columns)] gap-y-6 border-b border-border py-8 md:grid-cols-12 md:py-10">
	<a href={url} class="block md:col-span-4" tabindex="-1" aria-hidden="true">
		{a.bild && <img src={a.bild} alt="" width="800" height="600" loading="lazy" decoding="async" class="foto aspect-[4/3] bg-surface" data-tina-field={tinaField(a, 'bild')} />}
	</a>
	<div class="md:col-span-5">
		<H class="display text-[clamp(2rem,2vw+1.25rem,2.75rem)]">
			<a href={url} class="no-underline decoration-2 underline-offset-[0.15em] hover:text-primary-ink hover:underline" data-tina-field={tinaField(a, 'kurztitel')}>{a.kurztitel || a.titel}</a>
		</H>
		{a.untertitel && <p class="mt-2 text-lead font-medium leading-snug text-heading" data-tina-field={tinaField(a, 'untertitel')}>{a.untertitel}</p>}
		{a.kurzbeschreibung && <p class="mt-3 max-w-[52ch] text-muted" data-tina-field={tinaField(a, 'kurzbeschreibung')}>{a.kurzbeschreibung}</p>}
		<ul class="mt-5 flex flex-wrap gap-2" aria-label="Eckdaten">
			{art && <li class="tag">{art}</li>}
			{angebotFakten(a).map((f) => <li class="tag">{f}</li>)}
			{a.aufAnfrage && <li class="tag">Auf Anfrage</li>}
		</ul>
		{a.terminHinweis && <p class="mt-4 text-[0.9375rem] text-muted" data-tina-field={tinaField(a, 'terminHinweis')}>{a.terminHinweis}</p>}
	</div>
	<div class="flex flex-wrap items-end justify-between gap-4 md:col-span-3 md:flex-col md:items-end md:justify-end md:text-right">
		{preisSichtbar && (
			<p class="text-heading" data-tina-field={tinaField(a, 'preis')}>
				<span class="figur block text-figure">{formatEuro(a.preis!)}</span>
				<span class="text-[0.9375rem] text-muted">pro {einheit}</span>
			</p>
		)}
		<a href={`${anfrageUrl(a.slug)}#formular`} class="btn-primary">Anfrage senden<span class="sr-only">: {a.kurztitel || a.titel}</span></a>
	</div>
</article>
