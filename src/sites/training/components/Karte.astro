---
// The survey sketch of Karo's home ground (lib/karte.ts): the Luchberg cone and the Müglitz valley
// in contour lines, the forest as dots, a track, the river. Static SVG, built at build time: no
// script, no tiles. "beschriftet" adds the two real names; otherwise it is a quiet
// ground for the hero. "gipfel={false}" drops the summit dot where text runs over the map. Always decorative for screen readers (the facts are in the text beside it).
// "bewegt" (the start page's hero only): a dog's paw prints walk across the map now and then
// (lib/pfotenspur.ts, CSS opacity keyframes, paused off screen). Each route is its own group, so the CSS
// can pick the routes that the layout leaves visible (global.css, .karte-pfoten-route). With reduced
// motion: the static map. The track itself is always drawn.
// "orte" (the contact map only): labelled pins for the kinds of training places (lib/orte.ts), symbolic
// positions; they drop in one after another as the map scrolls into view (CSS view timeline).
import { karte, pfotenwege } from '../lib/karte';
import { pfotenspur } from '../lib/pfotenspur';
import { ortPunkte } from '../lib/orte';
import type { Ort } from '../lib/orte';

import type { KarteOptionen } from '../lib/karte';

interface Props { beschriftet?: boolean; gipfel?: boolean; bewegt?: boolean; orte?: Ort[]; optionen?: KarteOptionen; class?: string }
const { beschriftet = false, gipfel = true, bewegt = false, orte, optionen, class: klasse } = Astro.props;
const k = karte(optionen);
// One pass per route; the route's start in the cycle comes from the CSS (--route-start), the print's
// offset within its pass from lib/pfotenspur.ts.
const routen = bewegt ? pfotenwege(k).map((route, i) => pfotenspur(route, { seed: 5 + i, hoechstens: i === 2 ? 7 : 12 })) : [];
const pins = orte?.length ? ortPunkte(k, orte) : [];
---
<svg class:list={['karte', bewegt && 'karte-bewegt', pins.length > 0 && 'karte-mit-orten', klasse]} viewBox={`0 0 ${k.breite} ${k.hoehe}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
	<path d={k.wald} class="karte-wald" />
	{k.linien.map((l) => <path d={l.d} class:list={['karte-linie', l.stark && 'karte-linie-stark']} />)}
	<path d={k.bach} class="karte-fluss" />
	<path d={k.weg} class="karte-weg" />
	{bewegt && (
		<>
			<defs>
				<path id="karte-pfote" d="M-7.1 0a4.4 5.1 0 1 0 8.7 0a4.4 5.1 0 1 0-8.7 0M2 -5.8a2 2 0 1 0 3.9 0a2 2 0 1 0-3.9 0M4.5 -2.1a2 2 0 1 0 3.9 0a2 2 0 1 0-3.9 0M4.5 2.1a2 2 0 1 0 3.9 0a2 2 0 1 0-3.9 0M2 5.8a2 2 0 1 0 3.9 0a2 2 0 1 0-3.9 0" />
			</defs>
			<g class="karte-pfoten">
				{routen.map((spur, i) => (
					<g class={`karte-pfoten-route karte-pfoten-route-${i + 1}`}>
						{spur.map((p) => <use href="#karte-pfote" transform={`translate(${p.x} ${p.y}) rotate(${p.winkel})`} style={`--pfote:${p.zeit}s`} />)}
					</g>
				))}
			</g>
		</>
	)}
	{gipfel && <circle cx={k.gipfel.x} cy={k.gipfel.y} r="5" class="karte-punkt" />}
	{beschriftet && (
		<>
			<text x={k.gipfel.x} y={k.gipfel.y} dx="0.6em" dy="-0.35em" class="karte-name">Luchberg</text>
			<text x={k.gipfel.x} y={k.gipfel.y} dx="0.75em" dy="1.05em" class="karte-hoehe">576 m</text>
			<text x={k.fluss.x} y={k.fluss.y} dx="-0.6em" text-anchor="end" class="karte-name karte-name-fluss">Müglitz</text>
		</>
	)}
	{pins.map((p, i) => (
		<g transform={`translate(${p.x} ${p.y})`}>
			<g class="karte-ort" style={`--i:${i}`}>
				{p.art === 'vorOrt' && <circle r="64" class="karte-umkreis" />}
				<path d="M0 0C-5-13-18-22-18-35a18 18 0 1 1 36 0c0 13-13 22-18 35z" class="karte-pin" />
				<circle cy="-35" r="6.5" class="karte-pin-kern" />
				<text x={p.anker === 'start' ? 28 : -28} y="-35" dy="0.35em" text-anchor={p.anker} class="karte-ort-name">{p.name}</text>
			</g>
		</g>
	))}
</svg>
{bewegt && (
	<script is:inline>
		// Pause the paw trail while the hero is off screen (CSS runs it; this only saves the work).
		(() => { const s = document.currentScript.previousElementSibling; if (!s || !('IntersectionObserver' in window)) return; new IntersectionObserver(([e]) => s.classList.toggle('karte-ruht', !e.isIntersecting)).observe(s); })();
	</script>
)}
