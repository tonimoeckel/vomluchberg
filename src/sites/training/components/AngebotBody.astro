---
// Detail page of an offer: the head (Stage: text on six columns, the photo on six) with facts and
// price, the description beside a ruled list of what to bring, photos, the offer's own sections
// (AngebotAbschnitte.astro: each offer page has its own build-up), the inquiry form with this
// offer preselected (works without JS, on paper-2) and the other offers as price-list rows.
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import Icon from '../../../components/ui/Icon.astro';
import AngebotKarte from './AngebotKarte.astro';
import AngebotAbschnitte from './AngebotAbschnitte.astro';
import AnfrageFormular from './AnfrageFormular.astro';
import Kontaktliste from './Kontaktliste.astro';
import { angebotFakten, angebotJsonLd, angeboteListeUrl, artLabel, formatEuro, preisEinheiten, sichtbareAngebote } from '../../../lib/domain/angebot';
import { getConfig, listAngeboteMitSlug, type CmsAngebot } from '../lib/data';
import { training } from '../site';

interface Props { data?: CmsAngebot | null }
const { data: a } = Astro.props;
const slug = a?._sys.filename ?? '';
const config = (await getConfig()).data?.trainingConfig;
const angebote = await listAngeboteMitSlug();
const andere = sichtbareAngebote(angebote).filter((x) => x.slug !== slug);
const preisSichtbar = a?.preis != null && a.preisAnzeigen !== false;
const einheit = preisEinheiten.find((e) => e.value === a?.preisEinheit)?.label ?? 'Termin';
const mitbringen = (a?.mitbringen ?? []).filter(Boolean);
const seitenleiste = mitbringen.length > 0 || Boolean(a?.voraussetzungen);
const galerie = (a?.galerie ?? []).filter((g) => g?.bild);
const site = Astro.site?.href ?? Astro.url.origin;
const jsonLd = a && angebotJsonLd({ ...a, slug }, { name: config?.website?.name ?? training.name, url: site });
---
{a && (
	<article>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<section class="border-b border-border">
			<div class="container-page pt-8 pb-14 sm:pb-20">
				<nav aria-label="Brotkrümel" class="mb-10 text-[0.9375rem] text-muted">
					<ol class="flex flex-wrap gap-2">
						<li><a href={angeboteListeUrl} class="textlink">Angebote</a><span aria-hidden="true" class="ml-2">/</span></li>
						<li aria-current="page">{a.kurztitel || a.titel}</li>
					</ol>
				</nav>
				<div class="grid gap-x-[var(--gap-columns)] gap-y-10 lg:grid-cols-12 lg:items-center">
					<div class:list={[a.bild ? 'lg:col-span-6' : 'lg:col-span-9']}>
						<h1 class="display text-[clamp(2.75rem,3.4vw+1rem,4.5rem)]" data-tina-field={tinaField(a, 'titel')}>{a.titel}</h1>
						{a.untertitel && <p class="mt-4 text-lead font-medium leading-snug text-heading" data-tina-field={tinaField(a, 'untertitel')}>{a.untertitel}</p>}
						{a.kurzbeschreibung && <p class="mt-4 max-w-[52ch] text-muted" data-tina-field={tinaField(a, 'kurzbeschreibung')}>{a.kurzbeschreibung}</p>}
						<ul class="mt-6 flex flex-wrap gap-2" aria-label="Eckdaten">
							{artLabel(a.art) && <li class="tag">{artLabel(a.art)}</li>}
							{angebotFakten(a).map((f) => <li class="tag">{f}</li>)}
							{a.aufAnfrage && <li class="tag">Auf Anfrage</li>}
						</ul>
						{a.terminHinweis && <p class="mt-4 text-muted" data-tina-field={tinaField(a, 'terminHinweis')}>{a.terminHinweis}</p>}
						<div class="regel mt-8 flex flex-wrap items-end justify-between gap-x-8 gap-y-5 pt-6">
							{preisSichtbar && (
								<p class="text-heading" data-tina-field={tinaField(a, 'preis')}>
									<span class="figur block text-figure">{formatEuro(a.preis!)}</span>
									<span class="text-[0.9375rem] text-muted">pro {einheit}</span>
								</p>
							)}
							<a href="#formular" class="btn-primary">Anfrage senden</a>
						</div>
					</div>
					{a.bild && (
						<figure class="lg:col-span-6" data-tina-field={tinaField(a, 'bild')}>
							<img src={a.bild} alt={a.bildBeschreibung ?? ''} width="1200" height="900" class="foto aspect-[4/3] max-h-[620px]" fetchpriority="high" />
						</figure>
					)}
				</div>
			</div>
		</section>

		<section class="sektion">
			<div class="container-page grid gap-x-[var(--gap-columns)] gap-y-12 lg:grid-cols-12">
				{seitenleiste ? (
					<div class="lg:col-span-7">
						<h2 class="display mb-8 text-section">Darum geht’s</h2>
						<div class="prose prose-lg prose-site" data-tina-field={tinaField(a, 'body')}><TinaMarkdown content={a.body} /></div>
					</div>
				) : (
					<>
						<h2 class="display text-section lg:col-span-5">Darum geht’s</h2>
						<div class="prose prose-lg prose-site lg:col-span-7" data-tina-field={tinaField(a, 'body')}><TinaMarkdown content={a.body} /></div>
					</>
				)}
				{seitenleiste && (
					<aside class="self-start lg:col-span-4 lg:col-start-9">
						{mitbringen.length > 0 && (
							<>
								<h2 class="display break-words text-title">Das solltet ihr mitbringen</h2>
								<ul class="regel mt-5" data-tina-field={tinaField(a, 'mitbringen')}>
									{mitbringen.map((m) => <li class="flex gap-3 border-b border-border py-3"><Icon name="check" class="mt-0.5 size-5 shrink-0 text-accent" aria-hidden="true" />{m}</li>)}
								</ul>
							</>
						)}
						{a.voraussetzungen && (
							<>
								<h2 class={`display min-w-0 break-words text-title ${mitbringen.length > 0 ? 'mt-10' : ''}`}>Voraussetzungen</h2>
								<p class="regel mt-5 pt-4 text-muted" data-tina-field={tinaField(a, 'voraussetzungen')}>{a.voraussetzungen}</p>
							</>
						)}
					</aside>
				)}
			</div>
			{galerie.length > 0 && (
				<ul class="container-page mt-16 grid gap-x-[var(--gap-columns)] gap-y-8 md:grid-cols-12" data-tina-field={tinaField(a, 'galerie')}>
					{galerie.map((g, i) => (
						<li class:list={[galerie.length === 1 ? 'md:col-span-8' : galerie.length === 2 ? (i === 0 ? 'md:col-span-7' : 'md:col-span-5') : 'md:col-span-4']} data-tina-field={tinaField(g!)}>
							<a href={g!.bild!} data-lightbox={`angebot-${slug}`} data-caption={g!.beschreibung ?? ''} class="block hover:opacity-90">
								<img src={g!.bild!} alt={g!.beschreibung ?? ''} width="1200" height="900" loading="lazy" decoding="async" class="foto aspect-[4/3] md:aspect-auto md:h-[min(32vw,460px)]" />
							</a>
						</li>
					))}
				</ul>
			)}
		</section>

		<AngebotAbschnitte data={a} />

		<section class="sektion bg-surface">
			<div class="container-page grid items-start gap-x-[var(--gap-columns)] gap-y-12 lg:grid-cols-12">
				<div class="lg:col-span-5">
					<h2 class="display max-w-[16ch] text-section">{a.kurztitel || a.titel} anfragen</h2>
					<p class="mt-5 max-w-[48ch] text-lead leading-snug text-muted">Schreibt mir gern eine Nachricht. Wir schauen gemeinsam, was ihr zwei braucht, und finden einen passenden Termin.</p>
					<Kontaktliste config={config} />
				</div>
				<div class="lg:col-span-7">
					<AnfrageFormular angebote={angebote} config={config} vorausgewaehlt={slug} />
				</div>
			</div>
		</section>

		{andere.length > 0 && (
			<section class="sektion-m">
				<div class="container-page">
					<h2 class="display mb-14 text-section">Weitere Angebote</h2>
					<div class="regel">
						{andere.map((x) => <AngebotKarte angebot={x} />)}
					</div>
				</div>
			</section>
		)}
	</article>
)}
