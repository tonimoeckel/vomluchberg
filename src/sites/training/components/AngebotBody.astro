---
// Detail page of an offer: head with facts and price, description, what to bring, photos,
// the inquiry form with this offer preselected (works without JS) and the other offers.
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import Icon from '../../../components/ui/Icon.astro';
import AngebotKarte from './AngebotKarte.astro';
import AnfrageFormular from './AnfrageFormular.astro';
import Kontaktliste from './Kontaktliste.astro';
import { angebotFakten, angebotJsonLd, angeboteListeUrl, artLabel, formatEuro, preisEinheiten, sichtbareAngebote } from '../../../lib/domain/angebot';
import { getConfig, listAngeboteMitSlug, type CmsAngebot } from '../lib/data';
import { training } from '../site';

interface Props { data?: CmsAngebot | null }
const { data: a } = Astro.props;
const slug = a?._sys.filename ?? '';
const config = (await getConfig()).data?.trainingConfig;
const angebote = await listAngeboteMitSlug();
const andere = sichtbareAngebote(angebote).filter((x) => x.slug !== slug);
const nummer = (n: string) => sichtbareAngebote(angebote).findIndex((x) => x.slug === n) + 1;
const preisSichtbar = a?.preis != null && a.preisAnzeigen !== false;
const einheit = preisEinheiten.find((e) => e.value === a?.preisEinheit)?.label ?? 'Termin';
const mitbringen = (a?.mitbringen ?? []).filter(Boolean);
const galerie = (a?.galerie ?? []).filter((g) => g?.bild);
const site = Astro.site?.href ?? Astro.url.origin;
const jsonLd = a && angebotJsonLd({ ...a, slug }, { name: config?.website?.name ?? training.name, url: site });
---
{a && (
	<article>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<section class="relative overflow-hidden pt-8 pb-12 sm:pt-12 sm:pb-16">
			<div class="lanes absolute -top-[8%] -left-[10%] -z-10 h-[45%] w-[55%]" aria-hidden="true"></div>
			<div class="container-page">
				<nav aria-label="Brotkrümel" class="mb-6 flex flex-wrap gap-2 font-display text-[0.95rem] font-semibold uppercase tracking-[0.12em] text-muted">
					<a href={angeboteListeUrl} class="hover:text-primary-ink">Angebote</a> <span aria-hidden="true">/</span> <span aria-current="page">{a.kurztitel || a.titel}</span>
				</nav>
				<div class:list={['grid items-center gap-10 lg:gap-16', a.bild && 'lg:grid-cols-[1.1fr_0.9fr]']}>
					<div>
						<p class="kicker">{a.aufAnfrage ? `${artLabel(a.art)} · auf Anfrage` : artLabel(a.art)}</p>
						<h1 class="display mt-3 text-5xl sm:text-7xl" data-tina-field={tinaField(a, 'titel')}>{a.titel}</h1>
						{a.untertitel && <p class="mt-3 font-display text-2xl font-semibold italic leading-tight text-primary-ink" data-tina-field={tinaField(a, 'untertitel')}>{a.untertitel}</p>}
						{a.kurzbeschreibung && <p class="mt-5 max-w-[58ch] text-lg text-muted" data-tina-field={tinaField(a, 'kurzbeschreibung')}>{a.kurzbeschreibung}</p>}
						<ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Eckdaten">
							{angebotFakten(a).map((f) => <li class="chip">{f}</li>)}
						</ul>
						{a.terminHinweis && (
							<p class="mt-4 flex items-baseline gap-2 text-muted" data-tina-field={tinaField(a, 'terminHinweis')}>
								<span class="size-2 shrink-0 rounded-full bg-copper" aria-hidden="true"></span>{a.terminHinweis}
							</p>
						)}
						<div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-4">
							{preisSichtbar && (
								<p class="font-display text-4xl font-extrabold leading-none text-heading" data-tina-field={tinaField(a, 'preis')}>
									{formatEuro(a.preis!)} <small class="text-base font-semibold uppercase tracking-[0.06em] text-muted">/ {einheit}</small>
								</p>
							)}
							<a href="#formular" class="btn-primary">Anfrage senden →</a>
						</div>
					</div>
					{a.bild && (
						<div class="relative" data-tina-field={tinaField(a, 'bild')}>
							<div class="lanes-copper absolute -right-[10%] -bottom-[10%] -z-10 h-[60%] w-[70%]" aria-hidden="true"></div>
							<img src={a.bild} alt={a.bildBeschreibung ?? ''} class="aspect-[4/3] w-full rounded-card object-cover shadow-[var(--shadow)]" fetchpriority="high" />
						</div>
					)}
				</div>
			</div>
		</section>

		<section class="bg-surface py-14 sm:py-16">
			<div class:list={['container-page grid gap-10 lg:gap-16', (mitbringen.length > 0 || a.voraussetzungen) && 'lg:grid-cols-[1.4fr_1fr]']}>
				<div>
					<h2 class="display mb-5 text-4xl sm:text-5xl">Darum geht's</h2>
					<div class="prose prose-lg prose-site" data-tina-field={tinaField(a, 'body')}><TinaMarkdown content={a.body} /></div>
				</div>
				{(mitbringen.length > 0 || a.voraussetzungen) && (
					<aside class="card self-start border-t-4 border-t-heading p-6">
						{mitbringen.length > 0 && (
							<>
								<h2 class="font-display text-2xl font-extrabold uppercase text-heading">Das solltet ihr mitbringen</h2>
								<ul class="mt-4 grid gap-2.5" data-tina-field={tinaField(a, 'mitbringen')}>
									{mitbringen.map((m) => <li class="flex gap-2.5"><Icon name="check" class="mt-1 size-5 shrink-0 text-copper" />{m}</li>)}
								</ul>
							</>
						)}
						{a.voraussetzungen && (
							<>
								<h2 class:list={['font-display text-2xl font-extrabold uppercase text-heading', mitbringen.length > 0 && 'mt-6']}>Voraussetzungen</h2>
								<p class="mt-3 text-muted" data-tina-field={tinaField(a, 'voraussetzungen')}>{a.voraussetzungen}</p>
							</>
						)}
					</aside>
				)}
			</div>
			{galerie.length > 0 && (
				<ul class="container-page mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4" data-tina-field={tinaField(a, 'galerie')}>
					{galerie.map((g) => (
						<li class="overflow-hidden rounded-card" data-tina-field={tinaField(g!)}>
							<a href={g!.bild!} data-lightbox={`angebot-${slug}`} data-caption={g!.beschreibung ?? ''} class="group block">
								<img src={g!.bild!} alt={g!.beschreibung ?? ''} loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover group-hover:opacity-90" />
							</a>
						</li>
					))}
				</ul>
			)}
		</section>

		<section class="py-14 sm:py-20">
			<div class="container-page grid items-start gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
				<div>
					<p class="kicker">Anfrage</p>
					<h2 class="display mt-2 text-[2.6rem] sm:text-6xl">{a.kurztitel || a.titel} anfragen</h2>
					<p class="mt-4 max-w-[60ch] text-lg text-muted">Schreibt mir gern eine Nachricht – wir schauen gemeinsam, was ihr zwei braucht, und finden einen passenden Termin.</p>
					<Kontaktliste config={config} />
				</div>
				<AnfrageFormular angebote={angebote} config={config} vorausgewaehlt={slug} />
			</div>
		</section>

		{andere.length > 0 && (
			<section class="bg-surface py-14 sm:py-20">
				<div class="container-page">
					<p class="kicker">Weitere Angebote</p>
					<h2 class="display mt-2 mb-10 text-[2.6rem] sm:text-6xl">Das könnte auch passen</h2>
					<div class="grid gap-6 md:grid-cols-2">
						{andere.map((x) => <AngebotKarte angebot={x} nummer={nummer(x.slug)} />)}
					</div>
				</div>
			</section>
		)}
	</article>
)}
