---
// Head block of a section: the display head and one lead line. The kicker field is not shown (an
// eyebrow, Hallmark gate 54); it stays in Tina. Pass the block object to make the fields editable.
// "geteilt": head on the left, the lead on the right with the baselines aligned (layout.md § 4).
import { tinaField } from '@tinacms/astro/tina-field';

interface Props {
	data: Record<string, unknown> & { ueberschrift?: string | null; text?: string | null };
	/** Headline level (h1 on pages without a hero). */
	as?: 'h1' | 'h2';
	geteilt?: boolean;
	class?: string;
}
const { data, as: Tag = 'h2', geteilt = false, class: className } = Astro.props;
// tinaField() is typed per document; the heading fields are shared by several block types.
const feld = (name: 'ueberschrift' | 'text') => tinaField(data as never, name as never);
---
{(data.ueberschrift || data.text) && (
	<div class:list={[geteilt && 'grid gap-x-[var(--gap-columns)] gap-y-5 lg:grid-cols-12 lg:items-end', className]}>
		{data.ueberschrift && (
			<Tag class:list={['display max-w-[22ch] text-section', geteilt && 'lg:col-span-7']} data-tina-field={feld('ueberschrift')}>{data.ueberschrift}</Tag>
		)}
		{data.text && (
			<p class:list={['max-w-[52ch] text-lead leading-snug text-muted', geteilt ? 'lg:col-span-5 lg:pb-1.5' : 'mt-5']} data-tina-field={feld('text')}>{data.text}</p>
		)}
	</div>
)}
