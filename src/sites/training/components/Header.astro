---
// Header of the training site: logo at the left edge, the menu and the inquiry button at the right,
// a 1px ink rule beneath. Below md the menu folds into a <details> (no JS, no animation).
import { tinaField } from '@tinacms/astro/tina-field';
import Icon from '../../../components/ui/Icon.astro';
import Logo from './Logo.astro';
import type { CmsConfig } from '../lib/data';

interface Props { config?: CmsConfig | null }
const { config } = Astro.props;
const nav = (config?.nav ?? []).filter((n) => n !== null);
const button = config?.menueButton;
const pfad = Astro.url.pathname.replace(/\/$/, '') || '/';
const aktiv = (link: string) => link !== '/' && (pfad === link || pfad.startsWith(`${link}/`));
const linkKlasse = 'underline-offset-[0.35em] decoration-2 hover:text-primary-ink hover:underline';
---
<header class="relative z-30 border-b border-heading bg-bg">
	<div class="container-page flex h-[76px] items-center justify-between gap-6">
		<a href="/" aria-label="Alltag kann Sport – Startseite" class="shrink-0">
			<Logo website={config?.website} class="h-11 w-auto sm:h-[52px]" />
		</a>
		<nav aria-label="Hauptmenü" class="hidden items-center gap-10 md:flex">
			<ul class="flex items-center gap-8 text-[1.0625rem] font-medium" data-tina-field={config ? tinaField(config, 'nav') : undefined}>
				{nav.map((n) => (
					<li><a href={n.link} aria-current={aktiv(n.link) ? 'page' : undefined}
						class:list={[linkKlasse, aktiv(n.link) ? 'text-heading underline' : 'text-heading no-underline']}
						data-tina-field={tinaField(n)}>{n.titel}</a></li>
				))}
			</ul>
			{button?.label && button.link && <a href={button.link} class="btn-secondary" data-tina-field={tinaField(button)}>{button.label}</a>}
		</nav>
		<details class="group relative md:hidden">
			<summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 px-3 font-medium text-heading rounded-[var(--radius)] border border-muted bg-card hover:border-heading [&::-webkit-details-marker]:hidden">
				<Icon name="menu-2" class="size-5 group-open:hidden" /><Icon name="x" class="hidden size-5 group-open:block" />Menü
			</summary>
			<nav aria-label="Hauptmenü (mobil)" class="absolute right-0 top-full mt-3 w-72 rounded-[var(--radius)] border border-heading bg-bg p-4 shadow-[var(--shadow)]">
				<ul class="grid text-lg font-medium">
					{nav.map((n) => (
						<li class="border-b border-border last:border-b-0">
							<a href={n.link} aria-current={aktiv(n.link) ? 'page' : undefined} class="block py-3 text-heading no-underline hover:text-primary-ink">{n.titel}</a>
						</li>
					))}
				</ul>
				{button?.label && button.link && <a href={button.link} class="btn-primary mt-3 w-full">{button.label}</a>}
			</nav>
		</details>
	</div>
</header>
