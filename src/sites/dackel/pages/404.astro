---
import Base from '../layouts/Base.astro';
import Squiggle from '../components/ui/Squiggle.astro';
---
<Base title="Seite nicht gefunden">
	<section class="container-page py-24 text-center">
		<p class="eyebrow">404</p>
		<h1 class="mt-3 text-[clamp(2.2rem,5vw,3.4rem)]">Hier hat sich ein Dackel verbuddelt.</h1>
		<Squiggle class="mx-auto mt-3" />
		<p class="mt-6 text-lg text-muted">Diese Seite gibt es nicht (mehr).</p>
		<p class="mt-8"><a href="/" class="btn-primary">Zur Startseite</a></p>
	</section>
</Base>
