---
// Values as three ruled columns, numbered 01, 02, 03 (no cards, no icons).
import { tinaField } from '@tinacms/astro/tina-field';
import SectionHead from '../ui/SectionHead.astro';
import type { BlockOf } from '../../lib/data';
interface Props { data: BlockOf<'Highlights'> }
const { data } = Astro.props;
const items = (data.items ?? []).filter((i) => i !== null);
---
<section class="py-14 sm:py-18">
	<div class="container-page">
		<SectionHead kicker={data.kicker} titel={data.ueberschrift} fields={{ kicker: tinaField(data, 'kicker'), titel: tinaField(data, 'ueberschrift') }} />
		<ul class="grid gap-8 md:grid-cols-3 md:gap-6">
			{items.map((item, i) => (
				<li class="border-t-[3px] border-primary pt-5" data-tina-field={tinaField(item)}>
					<span class="font-display text-lg italic text-accent-ink" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
					{item.titel && <h3 class="mb-2.5 mt-1 text-[1.45rem]" data-tina-field={tinaField(item, 'titel')}>{item.titel}</h3>}
					{item.text && <p class="text-muted" data-tina-field={tinaField(item, 'text')}>{item.text}</p>}
				</li>
			))}
		</ul>
	</div>
</section>
