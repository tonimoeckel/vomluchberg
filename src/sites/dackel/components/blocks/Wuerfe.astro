---
// Litter list (automatic): current first, then planned, then past; honest empty state.
import { tinaField } from '@tinacms/astro/tina-field';
import WurfCard from '../WurfCard.astro';
import SectionHead from '../ui/SectionHead.astro';
import { listWuerfe, type BlockOf } from '../../lib/data';
interface Props { data: BlockOf<'Wuerfe'> }
const { data } = Astro.props;
const wuerfe = await listWuerfe();
---
<section class="py-14 sm:py-18">
	<div class="container-page">
		<SectionHead kicker={data.kicker} titel={data.ueberschrift} text={data.text}
			fields={{ kicker: tinaField(data, 'kicker'), titel: tinaField(data, 'ueberschrift'), text: tinaField(data, 'text') }} />
		{wuerfe.length > 0 ? (
			<ul class="grid gap-10 sm:grid-cols-2 md:grid-cols-3 md:gap-8">
				{wuerfe.map((w) => <li><WurfCard wurf={w} /></li>)}
			</ul>
		) : data.leer && (
			<div class="flex flex-col items-start gap-5 rounded-[1.25rem] border border-dashed border-border bg-surface px-6 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-8">
				<p class="max-w-xl text-lg" data-tina-field={tinaField(data, 'leer')}>{data.leer}</p>
				<a href="/kontakt" class="btn-primary flex-none">Unverbindlich anfragen</a>
			</div>
		)}
	</div>
</section>
