---
// Skeleton hero (real design: slice 1).
import { tinaField } from '@tinacms/astro/tina-field';
import type { BlockOf } from '../../lib/data';
interface Props { data: BlockOf<'Hero'> }
const { data } = Astro.props;
const buttons = (data.buttons ?? []).filter((b) => b !== null);
---
<section class:list={['bg-surface', data.variante === 'gross' ? 'py-16 sm:py-24' : 'py-10 sm:py-14']}>
	<div class:list={['container-page grid items-center gap-10', data.bild && 'lg:grid-cols-2']}>
		<div>
			{data.kicker && <p class="text-sm font-semibold uppercase tracking-wide text-accent-ink" data-tina-field={tinaField(data, 'kicker')}>{data.kicker}</p>}
			{data.titel && <h1 class="mt-3 text-4xl font-bold sm:text-5xl" data-tina-field={tinaField(data, 'titel')}>{data.titel}</h1>}
			{data.untertitel && <p class="mt-5 max-w-2xl text-lg text-muted" data-tina-field={tinaField(data, 'untertitel')}>{data.untertitel}</p>}
			{buttons.length > 0 && (
				<div class="mt-8 flex flex-wrap gap-3">
					{buttons.map((b) => <a data-tina-field={tinaField(b)} href={b.link} class={b.stil === 'sekundaer' ? 'btn-secondary' : 'btn-primary'}>{b.label}</a>)}
				</div>
			)}
		</div>
		{data.bild && <img src={data.bild} alt="" class="w-full rounded-card object-cover" data-tina-field={tinaField(data, 'bild')} />}
	</div>
</section>
