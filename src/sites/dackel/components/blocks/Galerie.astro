---
// Photos: "band" = the long horizontal strip under the hero (scroll-snap), "raster" = a grid.
// Every photo opens in the shared lightbox; descriptions double as alt texts.
import { tinaField } from '@tinacms/astro/tina-field';
import Fotoraster from '../ui/Fotoraster.astro';
import SectionHead from '../ui/SectionHead.astro';
import type { BlockOf } from '../../lib/data';
interface Props { data: BlockOf<'Galerie'> }
const { data } = Astro.props;
const bilder = (data.bilder ?? []).filter((b) => !!b?.bild).map((b) => b!);
const gruppe = `galerie-${bilder[0]?.bild?.split('/').pop() ?? 'x'}`;
const titel = data.ueberschrift ?? 'Fotos';
---
{bilder.length > 0 && (data.variante === 'band' ? (
	<section class="border-y border-border bg-surface py-5" aria-label={titel}>
		<ul tabindex="0" class="flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 [scrollbar-width:thin] focus-visible:outline-offset-[-3px]" data-tina-field={tinaField(data, 'bilder')}>
			{bilder.map((b) => (
				<li class="flex-none snap-start" data-tina-field={tinaField(b)}>
					<a href={b.bild} data-lightbox={gruppe} data-caption={b.beschreibung ?? ''} class="block">
						<img src={b.bild!} alt={b.beschreibung ?? ''} width="1600" height="1060" loading="lazy" decoding="async"
							class="aspect-[3/2] h-[9.5rem] w-auto rounded-xl object-cover" />
					</a>
				</li>
			))}
		</ul>
	</section>
) : (
	<section class="py-14 sm:py-18">
		<div class="container-page">
			<SectionHead kicker={data.kicker} titel={data.ueberschrift} fields={{ kicker: tinaField(data, 'kicker'), titel: tinaField(data, 'ueberschrift') }} />
			<Fotoraster bilder={bilder} gruppe={gruppe} field={tinaField(data, 'bilder')} />
		</div>
	</section>
))}
