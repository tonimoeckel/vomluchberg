---
import { tinaField } from '@tinacms/astro/tina-field';
import Querverweis from './Querverweis.astro';
import type { CmsConfig } from '../lib/data';

interface Props { config?: CmsConfig | null }
const { config } = Astro.props;
const w = config?.website;
const k = config?.kontakt;
const v = config?.verband;
const nav = (config?.nav ?? []).flatMap((n) => (n && n.link !== '/' ? [n] : []));
const jahr = new Date().getFullYear();
---
<footer class="mt-12 bg-dark py-12 text-[0.95rem] text-on-dark">
	<div class="container-page">
		<div class="grid gap-10 md:grid-cols-[1.3fr_1fr_1fr]">
			<div>
				<h2 class="mb-3 text-lg" data-tina-field={w ? tinaField(w, 'name') : undefined}>{w?.name}</h2>
				{k && (
					<address class="not-italic text-on-dark/85" data-tina-field={tinaField(config!, 'kontakt')}>
						{[k.name, k.strasse, k.ort].filter(Boolean).map((zeile) => <span class="block">{zeile}</span>)}
						{k.telefon && <a class="mt-3 block no-underline hover:underline" href={`tel:${k.telefon.replace(/[^+\d]/g, '')}`}>{k.telefon}</a>}
						{k.email && <a class="block break-all no-underline hover:underline" href={`mailto:${k.email}`}>{k.email}</a>}
					</address>
				)}
				{v?.text && (
					<p class="mt-4 text-sm text-on-dark/75" data-tina-field={tinaField(v, 'text')}>
						{v.link ? <a href={v.link} target="_blank" rel="noopener" class="underline decoration-sun underline-offset-4">{v.text}</a> : v.text}
					</p>
				)}
			</div>
			{nav.length > 0 && (
				<div>
					<h2 class="mb-3 text-lg">Seiten</h2>
					<ul class="grid gap-1.5">
						{nav.map((n) => <li><a class="text-on-dark/85 no-underline hover:text-on-dark hover:underline" href={n.link}>{n.titel}</a></li>)}
					</ul>
				</div>
			)}
			<Querverweis config={config} />
		</div>
		<div class="mt-10 flex flex-wrap justify-between gap-3 border-t border-on-dark/15 pt-5 text-sm text-on-dark/70">
			<p>© {jahr} {w?.name}</p>
			<ul class="flex gap-5">
				<li><a class="no-underline hover:underline" href="/impressum">Impressum</a></li>
				<li><a class="no-underline hover:underline" href="/datenschutz">Datenschutz</a></li>
			</ul>
		</div>
	</div>
</footer>
