---
// Detail page of a dog: arch photo, profile (dackelSteckbrief), text and gallery.
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import Fotoraster from '../ui/Fotoraster.astro';
import Squiggle from '../ui/Squiggle.astro';
import Zurueck from '../ui/Zurueck.astro';
import type { CmsHund } from '../../lib/data';
import { dackelHunde, dackelSteckbrief } from '../../../../lib/domain/dackel';
import { istErinnerung } from '../../../../lib/domain/hund';
interface Props { data?: CmsHund | null }
const { data } = Astro.props;
const steckbrief = data ? dackelSteckbrief(data) : [];
// The category label already says "Hündinnen" / "Vater"; the sex is only added for the others.
const badge = data && data.kategorie === 'erinnerung' ? dackelHunde.geschlechtBadge(data) : null;
const anzeigename = data?.rufname || data?.name;
---
{data && (
	<>
		<Zurueck href={dackelHunde.hundeListeUrl} label="Alle unsere Dackel" />
		<section class="container-page grid gap-12 pb-10 pt-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16 lg:pb-14">
			<figure class="arch-frame m-0 ml-4 w-[min(100%-1rem,26rem)] self-start justify-self-center lg:ml-0" data-tina-field={tinaField(data, 'bild')}>
				{data.bild && (
					<a href={data.bild} data-lightbox="hund" data-caption={anzeigename} class="block">
						<img src={data.bild} alt={anzeigename ?? ''} width="1600" height="1060" fetchpriority="high"
							class:list={['arch aspect-[4/5] w-full object-cover shadow-[var(--shadow-photo)]', istErinnerung(data) && 'grayscale-[30%]']} />
					</a>
				)}
			</figure>
			<div>
				<p class="eyebrow">{data.kategorie === 'deckrude' ? 'Deckrüde' : dackelHunde.kategorieLabel(data.kategorie)}{badge && ` · ${badge.label}`}</p>
				<h1 data-tina-field={tinaField(data, 'rufname')} class="mt-3 text-[clamp(2.4rem,6vw,4rem)]">{anzeigename}</h1>
				<Squiggle class="mt-3" />
				{data.rufname && data.name !== data.rufname && <p data-tina-field={tinaField(data, 'name')} class="mt-4 text-xl text-muted">{data.name}</p>}
				{steckbrief.length > 0 && (
					<dl class="mt-8 border-t-[3px] border-primary">
						{steckbrief.map((z) => (
							<div class="grid gap-1 border-b border-border py-3 sm:grid-cols-[9rem_1fr] sm:gap-4" data-tina-field={tinaField(data, z.feld as never)}>
								<dt class="font-display italic text-accent-ink">{z.label}</dt>
								<dd class="whitespace-pre-line">{z.wert}</dd>
							</div>
						))}
					</dl>
				)}
				{data.body && <div data-tina-field={tinaField(data, 'body')} class="prose prose-lg prose-dackel mt-8"><TinaMarkdown content={data.body} /></div>}
			</div>
		</section>
		{(data.galerie ?? []).some((b) => b?.bild) && (
			<section class="container-page py-10" data-tina-field={tinaField(data, 'galerie')}>
				<h2 class="mb-8 text-[clamp(1.6rem,3vw,2.1rem)]">Fotos von {anzeigename}</h2>
				<Fotoraster bilder={data.galerie ?? []} gruppe="hund-galerie" alt={anzeigename ?? ''} />
			</section>
		)}
	</>
)}
