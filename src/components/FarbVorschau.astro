---
/**
 * Kleiner Umschalter für die Farbabstimmung mit Karo.
 * Sichtbar, wenn PUBLIC_FARBVORSCHAU=true gesetzt ist oder die URL ?farbe=… enthält.
 * Die endgültige Wahl stellt Karo in Tina unter „Einstellungen → Farbschema“ ein.
 */
import { FARBSCHEMATA } from '../lib/farbschema';
interface Props { force?: boolean }
const { force = false } = Astro.props;
---
<div id="farbvorschau" hidden={!force} data-force={force ? '1' : undefined}
	class="fixed bottom-3 right-3 z-50 rounded-2xl border border-border bg-bg/95 p-2 shadow-2xl backdrop-blur">
	<p class="mb-1 px-1 text-[0.65rem] font-bold uppercase tracking-wide text-muted">Farbvorschau</p>
	<div class="flex gap-2">
		{FARBSCHEMATA.map((s) => (
			<button type="button" data-farbe-wahl={s.id} title={s.label}
				class="group flex flex-col items-center gap-0.5 rounded-xl px-1.5 py-1 text-[0.65rem] font-semibold hover:bg-surface">
				<span class="block size-6 rounded-full ring-2 ring-transparent ring-offset-2 ring-offset-bg group-aria-pressed:ring-fg" style={`background:${s.swatch}`}></span>
				{s.label}
			</button>
		))}
	</div>
</div>
<script is:inline>
	(() => {
		const box = document.getElementById('farbvorschau');
		if (!box) return;
		let aktiv = false;
		try { aktiv = !!localStorage.getItem('farbe'); } catch (e) {}
		if (box.dataset.force || aktiv || new URLSearchParams(location.search).has('farbe')) box.hidden = false;
		const sync = () => box.querySelectorAll('[data-farbe-wahl]').forEach((b) =>
			b.setAttribute('aria-pressed', String(b.dataset.farbeWahl === document.documentElement.dataset.farbe)));
		box.addEventListener('click', (e) => {
			const b = e.target.closest('[data-farbe-wahl]');
			if (!b) return;
			const html = document.documentElement;
			html.dataset.farbe = b.dataset.farbeWahl;
			// Picking the configured standard forgets the preview choice.
			try {
				if (b.dataset.farbeWahl === html.dataset.farbeStandard) localStorage.removeItem('farbe');
				else localStorage.setItem('farbe', b.dataset.farbeWahl);
			} catch (err) {}
			sync();
		});
		sync();
	})();
</script>
