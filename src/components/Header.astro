---
import { tinaField } from '@tinacms/astro/tina-field';
import Icon from './ui/Icon.astro';
import type { CmsConfig } from '../lib/data';

interface Props { config?: CmsConfig | null }
const { config } = Astro.props;
const nav = (config?.nav ?? []).filter((n) => n !== null);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (link: string) => (link === '/' ? path === '/' : path === link || path.startsWith(link + '/'));
---
<header class="sticky top-0 z-40 border-b border-border/70 bg-bg/85 backdrop-blur-md">
	<div class="h-1 w-full grad-bg"></div>
	<div class="container-page flex h-18 items-center justify-between gap-4 py-2">
		<a href="/" class="group flex min-w-0 items-center gap-3" data-tina-field={config?.website ? tinaField(config.website, 'name') : undefined}>
			{config?.website?.logo && (
				<img src={config.website.logo} alt="" width="48" height="58" class="h-12 w-auto shrink-0 transition group-hover:-rotate-6" data-tina-field={tinaField(config.website, 'logo')} />
			)}
			<span class="min-w-0 leading-tight">
				<span class="block truncate font-display text-lg font-extrabold sm:text-xl">{config?.website?.name}</span>
				{config?.website?.untertitel && <span class="hidden truncate text-xs font-medium text-muted sm:block">{config.website.untertitel}</span>}
			</span>
		</a>

		<nav aria-label="Hauptmenü" class="hidden lg:block">
			<ul class="flex items-center gap-1">
				{nav.map((item) => (
					<li data-tina-field={tinaField(item)}>
						<a
							href={item.link}
							aria-current={isActive(item.link) ? 'page' : undefined}
							class:list={[
								'relative rounded-full px-3.5 py-2 text-[0.95rem] font-semibold transition hover:bg-surface',
								isActive(item.link) && 'text-accent-ink after:absolute after:inset-x-3.5 after:-bottom-0.5 after:h-0.5 after:rounded-full after:bg-[image:var(--grad)]',
							]}
						>{item.titel}</a>
					</li>
				))}
			</ul>
		</nav>

		<details class="group relative lg:hidden">
			<summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full border border-border bg-bg [&::-webkit-details-marker]:hidden" aria-label="Menü öffnen">
				<Icon name="menu-2" class="size-6 group-open:hidden" />
				<Icon name="x" class="hidden size-6 group-open:block" />
			</summary>
			<nav aria-label="Mobiles Menü" class="absolute right-0 top-14 w-64 overflow-hidden rounded-2xl border border-border bg-bg p-2 shadow-2xl">
				<ul>
					{nav.map((item) => (
						<li>
							<a href={item.link} aria-current={isActive(item.link) ? 'page' : undefined}
								class:list={['block rounded-xl px-4 py-3 font-semibold hover:bg-surface', isActive(item.link) && 'bg-surface text-accent-ink']}>{item.titel}</a>
						</li>
					))}
				</ul>
			</nav>
		</details>
	</div>
</header>
