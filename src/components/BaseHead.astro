---
import '../styles/global.css';
import type { Farbschema } from '../lib/farbschema';

interface Props {
	title: string;
	description: string;
	image?: string | null;
	farbschema: Farbschema;
}

const { title, description, image, farbschema } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site ?? Astro.url) : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalURL} />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content={farbschema.themeColor.light} media="(prefers-color-scheme: light)" />
<meta name="theme-color" content={farbschema.themeColor.dark} media="(prefers-color-scheme: dark)" />
<meta property="og:type" content="website" />
<meta property="og:locale" content="de_DE" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{ogImage && <meta property="og:image" content={ogImage} />}
<meta name="twitter:card" content="summary_large_image" />
