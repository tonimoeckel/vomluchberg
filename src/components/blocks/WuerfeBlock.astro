---
import { tinaField } from '@tinacms/astro/tina-field';
import WurfCard from '../cards/WurfCard.astro';
import SectionTitle from './SectionTitle.astro';
import { listWuerfe, type BlockOf } from '../../lib/data';
interface Props { data: BlockOf<'PageBlocksWuerfe'> }
const { data } = Astro.props;
const wuerfe = await listWuerfe();
---
<section class="py-14 sm:py-20">
	<div class="container-page">
		<SectionTitle title={data.ueberschrift} text={data.text} field={tinaField(data, 'ueberschrift')} textField={tinaField(data, 'text')} />
		<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{wuerfe.map((w) => <li><WurfCard wurf={w} /></li>)}
		</ul>
	</div>
</section>
