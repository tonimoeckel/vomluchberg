---
import { tinaField } from '@tinacms/astro/tina-field';
import type { BlockOf } from '../../lib/data';
interface Props { data: BlockOf<'PageBlocksHero'> }
const { data } = Astro.props;
const buttons = (data.buttons ?? []).filter((b) => b !== null);
const gross = data.variante === 'gross';
---
{gross ? (
	<section class="relative overflow-hidden">
		<div class="pointer-events-none absolute -right-40 -top-40 size-[36rem] rounded-full opacity-40 blur-3xl grad-bg"></div>
		<div class="pointer-events-none absolute -left-40 top-1/3 size-[26rem] rounded-full opacity-20 blur-3xl grad-bg"></div>
		<div class="container-page relative grid items-center gap-10 py-12 md:py-20 lg:grid-cols-[1.05fr_1fr] lg:gap-14">
			<div>
				{data.kicker && <p class="kicker mb-6" data-tina-field={tinaField(data, 'kicker')}>{data.kicker}</p>}
				{data.titel && (
					<h1 data-tina-field={tinaField(data, 'titel')} class="text-5xl font-extrabold leading-[1.02] sm:text-6xl xl:text-7xl">
						{data.titel.split(' ').slice(0, -3).join(' ')}{' '}
						<span class="grad-text">{data.titel.split(' ').slice(-3).join(' ')}</span>
					</h1>
				)}
				{data.untertitel && <p data-tina-field={tinaField(data, 'untertitel')} class="mt-6 max-w-xl text-lg text-muted sm:text-xl">{data.untertitel}</p>}
				{buttons.length > 0 && (
					<div class="mt-9 flex flex-wrap gap-3">
						{buttons.map((b) => <a data-tina-field={tinaField(b)} href={b.link} class={b.stil === 'sekundaer' ? 'btn-secondary' : 'btn-primary'}>{b.label}</a>)}
					</div>
				)}
			</div>
			{data.bild && (
				<div class="relative mx-auto w-full max-w-xl" data-tina-field={tinaField(data, 'bild')}>
					<div class="absolute -inset-3 rotate-3 rounded-[2.5rem] grad-bg opacity-90 shadow-[var(--glow)]"></div>
					<img src={data.bild} alt="" width="1600" height="1067" fetchpriority="high"
						class="relative aspect-[4/3.4] w-full -rotate-1 rounded-[2.2rem] border-4 border-bg object-cover shadow-2xl" />
					<div class="absolute -bottom-5 -left-4 flex items-center gap-3 rounded-2xl border border-border bg-bg px-4 py-3 shadow-xl sm:-left-8">
						<span class="flex size-10 items-center justify-center rounded-full grad-bg text-white">
							<svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true"><path d="M12 13c-2.8 0-5 2.7-5 4.6 0 1.6 1.3 2.4 2.7 2.4 1 0 1.5-.5 2.3-.5s1.3.5 2.3.5c1.4 0 2.7-.8 2.7-2.4 0-1.9-2.2-4.6-5-4.6ZM6.2 11.8c1 .3 2.2-.5 2.5-1.8s-.1-2.6-1.2-2.9-2.2.5-2.5 1.8.2 2.6 1.2 2.9Zm11.6 0c1-.3 1.5-1.6 1.2-2.9s-1.5-2.1-2.5-1.8-1.5 1.6-1.2 2.9 1.5 2.1 2.5 1.8ZM10 7.3c1.1 0 1.9-1.2 1.9-2.6S11.1 2 10 2 8.1 3.3 8.1 4.7s.8 2.6 1.9 2.6Zm4 0c1.1 0 1.9-1.2 1.9-2.6S15.1 2 14 2s-1.9 1.3-1.9 2.7.8 2.6 1.9 2.6Z"/></svg>
						</span>
						<span class="text-sm leading-tight"><strong class="block font-display text-base">Zwinger „vom Luchberg“</strong><span class="text-muted">im ADRK seit 2021</span></span>
					</div>
				</div>
			)}
		</div>
	</section>
) : (
	<section class="relative overflow-hidden grad-soft">
		<div class="pointer-events-none absolute -right-24 -top-24 size-72 rounded-full opacity-30 blur-3xl grad-bg"></div>
		<div class="container-page relative py-14 sm:py-20">
			{data.kicker && <p class="kicker mb-5" data-tina-field={tinaField(data, 'kicker')}>{data.kicker}</p>}
			{data.titel && <h1 data-tina-field={tinaField(data, 'titel')} class="text-4xl font-extrabold sm:text-6xl">{data.titel}</h1>}
			{data.untertitel && <p data-tina-field={tinaField(data, 'untertitel')} class="mt-5 max-w-2xl text-lg text-muted">{data.untertitel}</p>}
			{buttons.length > 0 && (
				<div class="mt-8 flex flex-wrap gap-3">
					{buttons.map((b) => <a data-tina-field={tinaField(b)} href={b.link} class={b.stil === 'sekundaer' ? 'btn-secondary' : 'btn-primary'}>{b.label}</a>)}
				</div>
			)}
		</div>
	</section>
)}
