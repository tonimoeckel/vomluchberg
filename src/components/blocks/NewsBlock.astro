---
import { tinaField } from '@tinacms/astro/tina-field';
import NewsCard from '../cards/NewsCard.astro';
import SectionTitle from './SectionTitle.astro';
import { listNews, type BlockOf } from '../../lib/data';
import { neuesteNews, newsListeUrl } from '../../lib/domain/news';
interface Props { data: BlockOf<'PageBlocksNews'> }
const { data } = Astro.props;
const { beitraege: news, zeigeAlleLink } = neuesteNews(await listNews(), data.anzahl);
---
<section class="py-14 sm:py-20">
	<div class="container-page">
		<SectionTitle title={data.ueberschrift} field={tinaField(data, 'ueberschrift')} />
		<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{news.map((n) => <li><NewsCard news={n} /></li>)}
		</ul>
		{zeigeAlleLink && <p class="mt-10"><a href={newsListeUrl} class="btn-secondary">Alle Beiträge</a></p>}
	</div>
</section>
