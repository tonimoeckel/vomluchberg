---
import { tinaField } from '@tinacms/astro/tina-field';
import Galerie from '../Galerie.astro';
import SectionTitle from './SectionTitle.astro';
import type { BlockOf } from '../../lib/data';
interface Props { data: BlockOf<'PageBlocksGalerie'> }
const { data } = Astro.props;
---
<section class="py-14 sm:py-20">
	<div class="container-page" data-tina-field={tinaField(data, 'bilder')}>
		<SectionTitle title={data.ueberschrift} field={tinaField(data, 'ueberschrift')} />
		<Galerie items={data.bilder ?? []} gruppe="galerie" alt="Impression unserer Hunde" />
	</div>
</section>
