---
import { tinaField } from '@tinacms/astro/tina-field';
import HundCard from '../cards/HundCard.astro';
import SectionTitle from './SectionTitle.astro';
import { listHunde, type BlockOf } from '../../lib/data';
import { hundeListeUrl, hundeUebersicht } from '../../lib/domain/hund';
interface Props { data: BlockOf<'PageBlocksHunde'> }
const { data } = Astro.props;
const { gruppen, zeigeAlleLink } = hundeUebersicht(await listHunde(), data.kategorie);
---
<section class="py-14 sm:py-20">
	<div class="container-page">
		<SectionTitle title={data.ueberschrift} text={data.text} field={tinaField(data, 'ueberschrift')} textField={tinaField(data, 'text')} />
		<div class="space-y-16">
			{gruppen.map((g) => (
				<div>
					{g.titel && <h2 class="headline-line mb-8 text-2xl font-extrabold sm:text-3xl">{g.titel}</h2>}
					<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{g.hunde.map((h) => <li><HundCard hund={h} /></li>)}
					</ul>
				</div>
			))}
		</div>
		{zeigeAlleLink && <p class="mt-10"><a href={hundeListeUrl} class="btn-secondary">Alle unsere Hunde</a></p>}
	</div>
</section>
