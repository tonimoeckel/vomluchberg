---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FarbVorschau from '../components/FarbVorschau.astro';
import Lightbox from '../components/Lightbox.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { getConfig } from '../lib/data';
import { islands } from '../lib/islands';
import { farbschema } from '../lib/farbschema';
import { headMeta, type Seo } from '../lib/domain/seo';
import { luchberg } from '../sites/luchberg/site';

type Props = Partial<Seo>;

const config = (await getConfig()).data?.config ?? null;
const meta = headMeta(Astro.props, config?.website, luchberg.name);
const schema = farbschema(config?.farbschema);
const showSwitcher = import.meta.env.PUBLIC_FARBVORSCHAU === 'true';
---

<!doctype html>
<html lang="de" data-farbe={schema.id} data-farbe-standard={schema.id}>
	<head>
		<BaseHead {...meta} themeColor={schema.themeColor} />
		<script is:inline>
			// Colour preview (for reviewing with Karo): ?farbe=neon is remembered, ?farbe=<standard> forgets it.
			try {
				const h = document.documentElement;
				const p = new URLSearchParams(location.search).get('farbe');
				if (p === h.dataset.farbeStandard) localStorage.removeItem('farbe');
				else if (p) localStorage.setItem('farbe', p);
				const f = localStorage.getItem('farbe');
				if (f) h.dataset.farbe = f;
			} catch (e) {}
		</script>
	</head>
	<body class="min-h-dvh flex flex-col">
		<a href="#inhalt" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 btn-primary">Zum Inhalt springen</a>
		<TinaIsland name="global" wrapper={islands.global.wrapper}>
			<Header config={config} />
		</TinaIsland>
		<div id="inhalt" class="flex-1">
			<slot />
		</div>
		<TinaIsland name="global-footer" wrapper={islands['global-footer'].wrapper}>
			<Footer config={config} />
		</TinaIsland>
		<Lightbox />
		<FarbVorschau force={showSwitcher} />
	</body>
</html>
