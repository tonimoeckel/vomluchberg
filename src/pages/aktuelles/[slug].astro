---
import Detailseite from '../../layouts/Detailseite.astro';
import { aktuelles } from '../../lib/detailseiten';

export const getStaticPaths = aktuelles.paths;
const beitrag = await aktuelles.load(String(Astro.params.slug));
if (!beitrag) return new Response('Not Found', { status: 404 });
---
<Detailseite {...beitrag} />
