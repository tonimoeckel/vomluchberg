---
import Base from '../../layouts/Base.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import HundBody from '../../components/islands/HundBody.astro';
import { getHund, listHunde } from '../../lib/data';
import { islands } from '../../lib/islands';

export async function getStaticPaths() {
	return (await listHunde()).map((h) => ({ params: { slug: h._sys.filename } }));
}
const slug = String(Astro.params.slug);
const data = (await getHund(slug)).data?.hund;
if (!data) return new Response('Not Found', { status: 404 });
---
<Base title={data.name} description={`${data.name}${data.eltern ? ' – ' + data.eltern : ''}. Rottweiler vom Luchberg.`} image={data.bild}>
	<TinaIsland name="hund" wrapper={islands.hund.wrapper} params={{ slug }} primary>
		<HundBody data={data} />
	</TinaIsland>
</Base>
