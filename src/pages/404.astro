---
import Base from '../layouts/Base.astro';
---
<Base title="Seite nicht gefunden">
	<section class="container-page py-24 text-center">
		<p class="kicker">404</p>
		<h1 class="mt-5 text-5xl font-extrabold">Hier ist leider <span class="grad-text">niemand</span>.</h1>
		<p class="mt-4 text-lg text-muted">Die Seite gibt es nicht (mehr). Vielleicht findest du, was du suchst, auf der Startseite.</p>
		<p class="mt-8"><a href="/" class="btn-primary">Zur Startseite</a></p>
	</section>
</Base>
