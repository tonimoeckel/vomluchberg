{
  "name": "vomluchberg",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "dev:dackel": "SITE_ID=dackel npm run dev",
    "dev:training": "SITE_ID=training npm run dev",
    "build": "node scripts/build.mjs",
    "build:local": "tinacms build --local --skip-cloud-checks -c \"astro build\"",
    "build:local:dackel": "SITE_ID=dackel npm run build:local",
    "build:local:training": "SITE_ID=training npm run build:local",
    "build:local:all": "npm run build:local && npm run build:local:dackel && npm run build:local:training",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/node": "^10.1.4",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@iconify-json/tabler": "^1.2.35",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@tinacms/astro": "^0.7.0",
    "astro": "^6.4.4",
    "astro-icon": "^1.1.5",
    "clsx": "^2.1.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tinacms/cli": "^3.0.0",
    "@types/node": "^25.9.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tinacms": "^3.14.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vitest": "^5.0.2"
  }
}
