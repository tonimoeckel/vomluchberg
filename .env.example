# Production URL (sitemap, canonical & Open Graph URLs)
SITE_URL=https://www.vomluchberg.de

# TinaCloud – from app.tina.io → project → Overview / Tokens
PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Contact form (optional) – free access key from web3forms.com, sent to Karo's e-mail.
# Without a key the form falls back to opening the visitor's mail app.
PUBLIC_WEB3FORMS_KEY=

# Show the colour-scheme switcher (only for the design review with Karo / preview deployments)
PUBLIC_FARBVORSCHAU=false

# Optional: force an adapter locally (cloudflare | node). Cloudflare CI is auto-detected.
# DEPLOY_ADAPTER=cloudflare
