# Production URL (sitemap, canonical & Open Graph URLs)
SITE_URL=https://www.vomluchberg.de

# TinaCloud – from app.tina.io → project → Overview / Tokens
PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Contact form (optional) – free access key from web3forms.com, sent to Karo's e-mail.
# Without a key the form falls back to opening the visitor's mail app.
PUBLIC_WEB3FORMS_KEY=

# Show the colour-scheme switcher (only for the design review with Karo / preview deployments)
PUBLIC_FARBVORSCHAU=false

# Optional: force an adapter locally (cloudflare | node). Cloudflare CI is auto-detected.
# DEPLOY_ADAPTER=cloudflare

# Which website to build: luchberg (default, vomluchberg.de) | dackel | training.
# One worker per site, each with its own SITE_ID, SITE_URL and PUBLIC_WEB3FORMS_KEY. See docs/plan/00-multisite.md.
# Locally, `npm run dev:dackel` / `build:local:dackel` (and :training) set it for you.
# SITE_ID=luchberg

# Keep a deployment out of search engines (robots.txt disallows all, pages get meta robots noindex).
# Use for *.workers.dev deployments of sites that are not launched yet.
# Workers Builds of branches other than main (WORKERS_CI_BRANCH) are noindex automatically;
# SITE_NOINDEX=false switches that off.
# SITE_NOINDEX=true
